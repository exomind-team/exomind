---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { useTranslations } from '../../i18n';

const t = useTranslations('en');

const changelog = [
  {
    version: 'v0.3.6 In Development',
    date: 'Not formally released',
    changes: [
      { type: 'Feature', text: 'The task system keeps evolving around unified TaskNode semantics, dependency handling, and tighter today/timeblock linkage' },
      { type: 'Feature', text: 'Reminders, Agent Hub / network capabilities, and runtime-mesh work continue to land on the development line' },
      { type: 'Improvement', text: 'Agent and LLM integration is moving from Claude CLI toward OpenAI-compatible APIs and a unified session abstraction' },
      { type: 'Note', text: 'This reflects current development-line progress. The repository does not yet contain a formal release/v0.3.6 tag' },
    ],
  },
  {
    version: 'v0.3.5',
    date: 'Mar 6, 2026 (Released)',
    changes: [
      { type: 'Feature', text: 'Agent Hub UI reached the full T1-T9 scope with nodes, routes, topology, history, and detail side panels' },
      { type: 'Feature', text: 'Desktop adaptation was completed, together with history/chat flows, lifecycle controls, and Android-safe shortcuts' },
      { type: 'Fix', text: 'The voice shortcut flow was repaired and multi-round ASR became more stable' },
      { type: 'Improvement', text: 'The release pipeline unblocked Linux and macOS builds for the official v0.3.5 release' },
    ],
  },
  {
    version: 'v0.3.2',
    date: 'Feb 22, 2026 (Released)',
    changes: [
      { type: 'Feature', text: 'The first command palette shipped, along with follow-up fixes for scrolling and entry switching' },
      { type: 'Feature', text: 'The new UI became the default entry while still preserving a fallback path' },
      { type: 'Feature', text: 'Agent page toggles, Agent/Actor details, and device-view related UI iterations landed' },
      { type: 'Improvement', text: 'Build-tag, prerelease, and website foundations continued to solidify ahead of later public distribution work' },
    ],
  },
  {
    version: 'v0.3.1',
    date: 'Feb 15, 2026 (Released)',
    changes: [
      { type: 'Feature', text: 'The light-theme new UI reached a fully usable stage' },
      { type: 'Feature', text: 'Settings gained multi-user management and focus-card responsiveness fixes' },
      { type: 'Feature', text: 'Chat message copy support shipped' },
      { type: 'Improvement', text: 'The new focus timer card interactions and end-state settings were further refined' },
    ],
  },
];

function tagClasses(type: string) {
  switch (type) {
    case 'Feature': return 'bg-brand-50 text-brand-700 dark:bg-brand-900/30 dark:text-brand-300';
    case 'Fix': return 'bg-blue-50 text-blue-700 dark:bg-blue-900/30 dark:text-blue-300';
    case 'Improvement': return 'bg-green-50 text-green-700 dark:bg-green-900/30 dark:text-green-300';
    case 'Note': return 'bg-amber-50 text-amber-700 dark:bg-amber-900/30 dark:text-amber-300';
    default: return 'bg-stone-100 text-stone-600 dark:bg-stone-800 dark:text-stone-400';
  }
}
---

<BaseLayout title={t('changelog.title')}>
  {/* Hero */}
  <section class="relative overflow-hidden pt-32 pb-16">
    <div class="section-container relative z-10">
      <div class="mx-auto max-w-3xl text-center">
        <h1 class="heading-display text-4xl leading-tight text-stone-900 sm:text-5xl lg:text-6xl dark:text-stone-50">
          {t('changelog.title')}
        </h1>
        <p class="mt-4 text-lg leading-relaxed text-stone-500">
          {t('changelog.subtitle')}
        </p>
        <p class="mt-3 text-sm leading-relaxed text-stone-400">
          Note: released versions are summarized from real `release/*` tags in the repository. `v0.3.6` currently represents development-line progress, not a formal release tag.
        </p>
      </div>
    </div>
    <div class="absolute inset-0 -z-10">
      <div class="absolute left-1/2 top-0 h-[500px] w-[500px] -translate-x-1/2 -translate-y-1/2 rounded-full bg-brand/5 blur-3xl"></div>
    </div>
  </section>

  {/* Timeline */}
  <section class="pb-24">
    <div class="section-container">
      <div class="mx-auto max-w-3xl">
        <div class="relative border-l-2 border-brand/20 pl-8 dark:border-brand/30">
          {changelog.map((release, i) => (
            <div class:list={['relative', i > 0 ? 'mt-12' : '']}>
              {/* Dot on timeline */}
              <div class="absolute -left-[calc(2rem+5px)] top-0 h-3 w-3 rounded-full border-2 border-brand bg-white dark:bg-stone-950"></div>

              {/* Version + Date */}
              <div class="flex flex-wrap items-center gap-3">
                <span class="rounded-full bg-brand px-3 py-1 text-sm font-medium text-white">
                  {release.version}
                </span>
                <span class="text-sm text-stone-400">{release.date}</span>
              </div>

              {/* Changes */}
              <div class="mt-4 space-y-3">
                {release.changes.map((change) => (
                  <div class="card flex items-start gap-3 p-4">
                    <span class:list={['inline-flex shrink-0 rounded-md px-2 py-0.5 text-xs font-medium', tagClasses(change.type)]}>
                      {change.type}
                    </span>
                    <span class="text-sm text-stone-700 dark:text-stone-300">{change.text}</span>
                  </div>
                ))}
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
