---
import { prependBasePath, useTranslations } from '../i18n';

type Lang = 'zh' | 'en';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const isZh = lang === 'zh';

const platforms = [
  { name: 'Windows', icon: 'windows', req: t('download.sysreq.windows'), assetKey: 'windows-x64-setup' },
  { name: 'Android', icon: 'android', req: t('download.sysreq.android'), assetKey: 'android-arm64' },
  { name: 'macOS', icon: 'macos', req: t('download.sysreq.macos'), assetKey: 'macos-aarch64' },
  { name: 'Linux', icon: 'linux', req: t('download.sysreq.linux'), assetKey: 'linux-x64-appimage' },
] as const;

const channels = [
  {
    key: 'release',
    eyebrow: isZh ? 'STABLE CHANNEL / 稳定通道' : 'STABLE CHANNEL / 正式通道',
    title: isZh ? '最新稳定版' : 'Latest Stable',
    description: isZh ? '正式发布通道，适合日常长期使用。' : 'Formal release channel for everyday use.',
    emptyText: isZh ? '暂无正式版' : 'No stable release yet',
  },
  {
    key: 'preview',
    eyebrow: isZh ? 'PREVIEW CHANNEL / 预览通道' : 'PREVIEW CHANNEL / 预览通道',
    title: isZh ? '最新预览版' : 'Latest Preview',
    description: isZh ? '预览构建通道，更新更快，也可能更早暴露变化。' : 'Fast-moving preview channel for earlier builds.',
    emptyText: isZh ? '暂无预览版' : 'No preview release yet',
  },
] as const;

const extraLabels = isZh
  ? {
      'windows-x64-installer': 'MSI 安装包 / MSI installer',
      'android-x86': 'x86 版本 / x86 build',
      'linux-x64-deb': 'DEB 包 / DEB package',
    }
  : {
      'windows-x64-installer': 'MSI installer / MSI 安装包',
      'android-x86': 'x86 build / x86 版本',
      'linux-x64-deb': 'DEB package / DEB 包',
    };

const config = {
  locale: isZh ? 'zh-CN' : 'en-US',
  urls: {
    release: prependBasePath('/releases/release/versions.json'),
    preview: prependBasePath('/releases/preview/versions.json'),
    fallback: 'https://github.com/exomind-team/exomind/releases',
  },
  copy: {
    loading: isZh ? '正在加载版本信息…' : 'Loading release metadata…',
    loadFailed: isZh ? '版本信息加载失败，请直接前往 GitHub Releases。' : 'Failed to load release metadata. Open GitHub Releases directly.',
    noBuilds: isZh ? '当前通道暂无该平台安装包' : 'No build for this platform in this channel',
    releaseLink: isZh ? '查看 Release' : 'View Release',
    fallbackLink: isZh ? '查看全部 Releases' : 'View all releases',
    historyTitle: isZh ? '版本列表' : 'Version History',
    historyEmpty: isZh ? '暂无历史版本' : 'No versions yet',
    viewVersion: isZh ? '查看' : 'View',
    more: isZh ? '查看更多版本' : 'View more versions',
    collapse: isZh ? '收起' : 'Collapse',
    versionLabel: isZh ? '当前版本' : 'Current version',
    publishedLabel: isZh ? '发布时间' : 'Published',
    refreshedLabel: isZh ? '元数据刷新' : 'Metadata synced',
  },
  extraLabels,
};
---

<section class="relative overflow-hidden pt-32 pb-16">
  <div class="section-container relative z-10">
    <div class="mx-auto max-w-3xl text-center">
      <h1 class="heading-display text-5xl leading-tight text-stone-900 sm:text-6xl dark:text-stone-50">
        {t('download.title')}
      </h1>
      <p class="mt-6 text-lg leading-relaxed text-stone-500 sm:text-xl">
        {t('download.subtitle')}
      </p>
    </div>
  </div>
  <div class="absolute inset-0 -z-10">
    <div class="absolute left-1/2 top-0 h-[600px] w-[600px] -translate-x-1/2 -translate-y-1/2 rounded-full bg-brand/5 blur-3xl"></div>
  </div>
</section>

<section class="pb-20">
  <div class="section-container">
    <div class="mx-auto grid max-w-6xl gap-8 xl:grid-cols-2">
      {channels.map((channel) => (
        <article
          class="rounded-[28px] border border-stone-200/80 bg-white/90 p-8 shadow-sm backdrop-blur dark:border-stone-800 dark:bg-stone-900/90"
          data-channel-panel={channel.key}
          data-empty-text={channel.emptyText}
          data-load-failed-text={config.copy.loadFailed}
          data-testid={`download-channel-${channel.key}`}
        >
          <div class="flex flex-col gap-4 sm:flex-row sm:items-start sm:justify-between">
            <div>
              <p class="text-xs font-semibold uppercase tracking-[0.24em] text-brand/80">
                {channel.eyebrow}
              </p>
              <h2 class="mt-3 heading-display text-3xl text-stone-900 dark:text-stone-50">
                {channel.title}
              </h2>
              <p class="channel-summary mt-3 text-sm leading-relaxed text-stone-500">
                {channel.description}
              </p>
            </div>
            <a
              href="#"
              target="_blank"
              rel="noopener noreferrer"
              class="channel-link btn-secondary hidden px-4 py-2 text-sm"
              data-testid={`download-channel-${channel.key}-link`}
            >
              {config.copy.releaseLink}
            </a>
          </div>

          <div class="channel-empty mt-6 hidden rounded-2xl border border-dashed border-stone-200 bg-stone-50/80 p-5 dark:border-stone-700 dark:bg-stone-950/60">
            <p class="channel-empty-text text-sm text-stone-500 dark:text-stone-400">{channel.emptyText}</p>
            <a
              href={config.urls.fallback}
              target="_blank"
              rel="noopener noreferrer"
              class="channel-fallback-link mt-4 inline-flex text-sm font-medium text-brand transition-colors hover:text-brand-600"
              data-testid={`download-channel-${channel.key}-fallback`}
            >
              {config.copy.fallbackLink}
            </a>
          </div>

          <div class="channel-content mt-6 hidden">
            <div class="grid gap-4 md:grid-cols-3">
              <div class="rounded-2xl border border-stone-200 bg-stone-50/80 px-5 py-4 dark:border-stone-800 dark:bg-stone-950/60">
                <p class="text-xs font-medium uppercase tracking-[0.2em] text-stone-400">
                  {config.copy.versionLabel}
                </p>
                <p class="channel-version mt-2 text-lg font-semibold text-stone-900 dark:text-stone-50"></p>
              </div>
              <div class="rounded-2xl border border-stone-200 bg-stone-50/80 px-5 py-4 dark:border-stone-800 dark:bg-stone-950/60">
                <p class="text-xs font-medium uppercase tracking-[0.2em] text-stone-400">
                  {config.copy.publishedLabel}
                </p>
                <p class="channel-published mt-2 text-sm font-medium text-stone-900 dark:text-stone-50"></p>
              </div>
              <div class="rounded-2xl border border-stone-200 bg-stone-50/80 px-5 py-4 dark:border-stone-800 dark:bg-stone-950/60">
                <p class="text-xs font-medium uppercase tracking-[0.2em] text-stone-400">
                  {config.copy.refreshedLabel}
                </p>
                <p class="channel-refreshed mt-2 text-sm font-medium text-stone-900 dark:text-stone-50"></p>
              </div>
            </div>

            <div class="mt-6 grid gap-4 sm:grid-cols-2">
              {platforms.map((platform) => (
                <div
                  class="rounded-2xl border border-stone-200 bg-stone-50/70 p-6 text-center dark:border-stone-800 dark:bg-stone-950/60"
                  data-platform-card={platform.assetKey}
                >
                  <div class="mb-4 flex h-16 w-16 items-center justify-center rounded-2xl bg-stone-100 text-stone-700 dark:bg-stone-800 dark:text-stone-300">
                    {platform.icon === 'windows' && (
                      <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 30 30" fill="currentColor">
                        <path d="M0 4.5l12.6-1.7v12.1H0zm13.8-1.9L30 0v14.9H13.8zM0 16.8h12.6v12.1L0 27.2zm13.8-.3H30V30l-16.2-2.5z"></path>
                      </svg>
                    )}
                    {platform.icon === 'android' && (
                      <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="currentColor">
                        <path d="M6 18c0 .55.45 1 1 1h1v3.5c0 .83.67 1.5 1.5 1.5s1.5-.67 1.5-1.5V19h2v3.5c0 .83.67 1.5 1.5 1.5s1.5-.67 1.5-1.5V19h1c.55 0 1-.45 1-1V8H6v10zM3.5 8C2.67 8 2 8.67 2 9.5v7c0 .83.67 1.5 1.5 1.5S5 17.33 5 16.5v-7C5 8.67 4.33 8 3.5 8zm17 0c-.83 0-1.5.67-1.5 1.5v7c0 .83.67 1.5 1.5 1.5s1.5-.67 1.5-1.5v-7c0-.83-.67-1.5-1.5-1.5zM15.53 2.16l1.3-1.3c.2-.2.2-.51 0-.71-.2-.2-.51-.2-.71 0l-1.48 1.48A5.84 5.84 0 0 0 12 1c-.96 0-1.86.23-2.66.63L7.85.15c-.2-.2-.51-.2-.71 0-.2.2-.2.51 0 .71l1.31 1.31A5.983 5.983 0 0 0 6 7h12c0-1.98-.96-3.73-2.47-4.84zM10 5H9V4h1v1zm5 0h-1V4h1v1z"></path>
                      </svg>
                    )}
                    {platform.icon === 'macos' && (
                      <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                        <rect width="20" height="14" x="2" y="3" rx="2"></rect>
                        <line x1="8" x2="16" y1="21" y2="21"></line>
                        <line x1="12" x2="12" y1="17" y2="21"></line>
                      </svg>
                    )}
                    {platform.icon === 'linux' && (
                      <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                        <polyline points="4 17 10 11 4 5"></polyline>
                        <line x1="12" x2="20" y1="19" y2="19"></line>
                      </svg>
                    )}
                  </div>
                  <h3 class="text-lg font-semibold text-stone-900 dark:text-stone-50">{platform.name}</h3>
                  <p class="mt-2 text-sm text-stone-500 dark:text-stone-400">{platform.req}</p>

                  <div class="platform-loading mt-4">
                    <div class="mx-auto h-4 w-20 animate-pulse rounded bg-stone-200 dark:bg-stone-700"></div>
                    <div class="mx-auto mt-2 h-3 w-28 animate-pulse rounded bg-stone-100 dark:bg-stone-800"></div>
                    <div class="mx-auto mt-4 h-10 w-28 animate-pulse rounded-xl bg-stone-200 dark:bg-stone-700"></div>
                  </div>

                  <div class="platform-loaded hidden">
                    <p class="platform-version mt-4 text-sm text-stone-500 dark:text-stone-400"></p>
                    <p class="platform-meta mt-1 text-xs text-stone-400"></p>
                    <div class="mt-4">
                      <a
                        href="#"
                        target="_blank"
                        rel="noopener noreferrer"
                        class="platform-download-btn btn-primary px-6 py-2.5 text-sm"
                        data-testid={`download-${channel.key}-${platform.assetKey}`}
                      >
                        {t('download.btn')}
                      </a>
                    </div>
                    <div class="platform-extra-links mt-3 flex flex-wrap justify-center gap-3"></div>
                  </div>

                  <div class="platform-empty hidden">
                    <p class="mt-4 text-sm text-stone-400">{config.copy.noBuilds}</p>
                  </div>
                </div>
              ))}
            </div>

            <div class="channel-history mt-8 hidden">
              <h3 class="text-lg font-semibold text-stone-900 dark:text-stone-50">
                {config.copy.historyTitle}
              </h3>
              <div class="channel-history-list mt-4 space-y-3"></div>
              <div class="channel-history-expand mt-4 hidden text-center">
                <button class="text-sm font-medium text-brand transition-colors hover:text-brand-600">
                  {config.copy.more}
                </button>
              </div>
            </div>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<section class="pb-24">
  <div class="section-container">
    <div class="mx-auto max-w-2xl">
      <h2 class="heading-display text-center text-2xl text-stone-900 sm:text-3xl dark:text-stone-50">
        {t('download.sysreq.title')}
      </h2>
      <div class="mt-8 space-y-4">
        {platforms.map((platform) => (
          <div class="flex items-center gap-4 rounded-xl border border-stone-200 bg-white px-6 py-4 dark:border-stone-800 dark:bg-stone-900">
            <span class="w-24 shrink-0 font-medium text-stone-900 dark:text-stone-50">{platform.name}</span>
            <span class="text-sm text-stone-500 dark:text-stone-400">{platform.req}</span>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

<script type="application/json" id="download-page-config" set:html={JSON.stringify(config)}></script>

<script>
  import { buildHistoryEntries, resolvePlatformDownload } from '../lib/downloads-data';

  const configElement = document.getElementById('download-page-config');
  const config = configElement?.textContent ? JSON.parse(configElement.textContent) : null;
  const panels = Array.from(document.querySelectorAll('[data-channel-panel]'));

  function formatSize(bytes) {
    return `${(bytes / (1024 * 1024)).toFixed(1)} MB`;
  }

  function formatDate(isoString, locale) {
    const date = new Date(isoString);
    return new Intl.DateTimeFormat(locale, {
      year: 'numeric',
      month: '2-digit',
      day: '2-digit',
    }).format(date);
  }

  function setPanelError(panel, message) {
    panel.querySelector('.channel-content')?.classList.add('hidden');
    const emptyBlock = panel.querySelector('.channel-empty');
    emptyBlock?.classList.remove('hidden');
    const emptyText = panel.querySelector('.channel-empty-text');
    if (emptyText) emptyText.textContent = message;
  }

  function setPlatformFallback(card, message) {
    card.querySelector('.platform-loading')?.classList.add('hidden');
    card.querySelector('.platform-loaded')?.classList.add('hidden');
    card.querySelector('.platform-empty')?.classList.remove('hidden');
    const fallbackText = card.querySelector('.platform-empty p');
    if (fallbackText) fallbackText.textContent = message;
  }

  function renderPlatformCards(panel, channelKey, latest) {
    const platformCards = Array.from(panel.querySelectorAll('[data-platform-card]'));

    platformCards.forEach((card) => {
      if (!card) return;
      const button = card.querySelector('.platform-download-btn');
      const testId = button?.getAttribute('data-testid') ?? '';
      const assetKey = testId.replace(`download-${channelKey}-`, '');
      const resolved = resolvePlatformDownload(latest, assetKey);

      if (!resolved) {
        setPlatformFallback(card, config.copy.noBuilds);
        return;
      }

      const versionElement = card.querySelector('.platform-version');
      const metaElement = card.querySelector('.platform-meta');
      const extraLinks = card.querySelector('.platform-extra-links');

      card.querySelector('.platform-loading')?.classList.add('hidden');
      card.querySelector('.platform-empty')?.classList.add('hidden');
      card.querySelector('.platform-loaded')?.classList.remove('hidden');

      if (versionElement) versionElement.textContent = `v${resolved.version}`;
      if (metaElement) {
        metaElement.textContent = `${formatDate(resolved.publishedAt, config.locale)} · ${formatSize(resolved.primary.size)}`;
      }
      if (button) button.href = resolved.primary.url;
      if (extraLinks) {
        extraLinks.innerHTML = resolved.extras
          .map((extra) => {
            const label = config.extraLabels[extra.key] ?? extra.label;
            const sizeLabel = extra.size ? ` (${formatSize(extra.size)})` : '';
            return `<a href="${extra.url}" target="_blank" rel="noopener noreferrer" class="text-xs text-brand transition-colors underline underline-offset-2 hover:text-brand-600">${label}${sizeLabel}</a>`;
          })
          .join('');
      }
    });
  }

  function renderHistory(panel, index) {
    const historyBlock = panel.querySelector('.channel-history');
    const historyList = panel.querySelector('.channel-history-list');
    const expandBlock = panel.querySelector('.channel-history-expand');
    const expandButton = expandBlock?.querySelector('button');
    const entries = buildHistoryEntries(index);

    if (!historyBlock || !historyList || !expandBlock || !expandButton) {
      return;
    }

    if (!entries.length) {
      historyBlock.classList.remove('hidden');
      historyList.innerHTML = `<p class="text-sm text-stone-400">${config.copy.historyEmpty}</p>`;
      expandBlock.classList.add('hidden');
      return;
    }

    const initialCount = 5;
    let showAll = false;

    const renderEntries = () => {
      const visibleEntries = showAll ? entries : entries.slice(0, initialCount);
      historyList.innerHTML = visibleEntries
        .map(
          (entry) => `
            <div class="flex items-center justify-between rounded-xl border border-stone-200 bg-white px-5 py-4 dark:border-stone-800 dark:bg-stone-900">
              <div>
                <span class="font-medium text-stone-900 dark:text-stone-50">v${entry.version}</span>
                <span class="ml-3 text-xs text-stone-400">${formatDate(entry.publishedAt, config.locale)}</span>
              </div>
              <a href="${entry.releaseUrl}" target="_blank" rel="noopener noreferrer" class="text-sm font-medium text-brand transition-colors hover:text-brand-600">${config.copy.viewVersion}</a>
            </div>
          `,
        )
        .join('');
    };

    renderEntries();
    historyBlock.classList.remove('hidden');
    if (entries.length > initialCount) {
      expandBlock.classList.remove('hidden');
      expandButton.textContent = config.copy.more;
      expandButton.onclick = () => {
        showAll = !showAll;
        expandButton.textContent = showAll ? config.copy.collapse : config.copy.more;
        renderEntries();
      };
      return;
    }

    expandBlock.classList.add('hidden');
  }

  function renderChannel(panel, channelKey, index) {
    const latest = index?.latest ?? null;
    const link = panel.querySelector('.channel-link');

    if (!latest) {
      setPanelError(panel, panel.dataset.emptyText ?? config.copy.historyEmpty);
      return;
    }

    panel.querySelector('.channel-empty')?.classList.add('hidden');
    panel.querySelector('.channel-content')?.classList.remove('hidden');

    const version = panel.querySelector('.channel-version');
    const published = panel.querySelector('.channel-published');
    const refreshed = panel.querySelector('.channel-refreshed');

    if (version) version.textContent = `v${latest.version}`;
    if (published) published.textContent = formatDate(latest.published_at, config.locale);
    if (refreshed) refreshed.textContent = formatDate(index.generated_at, config.locale);
    if (link) {
      link.classList.remove('hidden');
      link.href = latest.release_url;
    }

    renderPlatformCards(panel, channelKey, latest);
    renderHistory(panel, index);
  }

  async function loadChannel(panel) {
    const channelKey = panel.dataset.channelPanel;
    if (!channelKey || !config?.urls?.[channelKey]) {
      return;
    }

    try {
      const response = await fetch(config.urls[channelKey]);
      if (!response.ok) {
        throw new Error(`HTTP ${response.status}`);
      }
      const index = await response.json();
      renderChannel(panel, channelKey, index);
    } catch (error) {
      console.error(`Failed to load ${channelKey} release metadata:`, error);
      setPanelError(panel, panel.dataset.loadFailedText ?? config.copy.loadFailed);
    }
  }

  if (config && panels.length > 0) {
    void Promise.all(panels.map((panel) => loadChannel(panel)));
  }
</script>
