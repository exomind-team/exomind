# ExoMind 环境变量配置示例
# 复制此文件为 .env 并填入实际值

# === MiniMax API ===
# MiniMax API Key (必需)
MINI_MAX_API_KEY=your_api_key_here
MINI_MAX_API_BASE=https://api.minimaxi.com/anthropic
MINI_MAX_MODEL=MiniMax-M2.1

# === Telegram Bot ===
# Telegram Bot Token (必需)
TELEGRAM_BOT_TOKEN=your_bot_token_here

# === Claude Code 代理 ===
# 用于绕过网络限制访问 Claude API
ANTHROPIC_BASE_URL=http://127.0.0.1:15721

# === 代理配置 ===
HTTPS_PROXY=http://127.0.0.1:7890

# === 应用配置 ===
NODE_ENV=development
LOG_LEVEL=info

# === 调试选项 ===
# DEBUG=*
# VERBOSE=true
