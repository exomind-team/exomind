---
import {
  Blocks,
  BookOpenText,
  CirclePlay,
  ScrollText,
  UsersRound,
} from "lucide-static";
import BrandMark from "./BrandMark.astro";
import LucideIcon from "./LucideIcon.astro";
import { getLangFromUrl, useTranslations, languages, getLocalizedPath, getLanguageSwitchPath } from '../i18n';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const currentPath = Astro.url.pathname;
const githubRepoUrl = 'https://github.com/exomind-team/exomind';
const brandName = lang === 'zh' ? '外心' : 'ExoMind';
const isDocsRoute = /^\/(?:en\/)?docs(?:\/|$)/.test(currentPath);
const headerContainerClass = isDocsRoute
  ? 'w-full px-5 sm:px-6 lg:px-8'
  : 'section-container';
const mobileMenuContainerClass = isDocsRoute
  ? 'w-full space-y-1 px-5 py-4 sm:px-6 lg:px-8'
  : 'section-container space-y-1 py-4';

const navItems = [
  { href: getLocalizedPath('/features', lang), label: t('nav.features'), icon: Blocks },
  { href: getLocalizedPath('/changelog', lang), label: t('nav.changelog'), icon: ScrollText },
  { href: getLocalizedPath('/getting-started', lang), label: t('nav.getting_started'), icon: CirclePlay },
  { href: getLocalizedPath('/docs', lang), label: t('nav.docs'), icon: BookOpenText },
  { href: getLocalizedPath('/about', lang), label: t('nav.about'), icon: UsersRound },
];
---

<header data-site-header class="fixed top-0 z-50 w-full border-b border-stone-200/60 bg-stone-50/80 backdrop-blur-xl dark:border-stone-800/60 dark:bg-stone-950/80">
  <div data-header-row class:list={[headerContainerClass, 'flex h-16 items-center justify-between gap-4']}>
    <div class="flex min-w-0 items-center gap-1">
      <a
        href={getLocalizedPath('/', lang)}
        data-header-brand
        class="-ml-3 flex items-center gap-2.5 rounded-lg px-3 py-2 transition-colors hover:bg-stone-100 dark:hover:bg-stone-800"
      >
        <BrandMark class="h-9 w-9 shrink-0" imgClass="p-0.5" />
        <span class="text-lg font-semibold tracking-tight text-stone-900 dark:text-stone-50">{brandName}</span>
      </a>

      <nav data-desktop-nav class="hidden items-center gap-1 md:flex md:flex-nowrap">
        {navItems.map(({ href, label, icon }) => (
          <a
            href={href}
            data-desktop-nav-link
            aria-label={label}
            title={label}
            class="inline-flex items-center gap-2 rounded-lg px-3 py-2 text-sm text-stone-600 transition-colors hover:bg-stone-100 hover:text-stone-900 dark:text-stone-400 dark:hover:bg-stone-800 dark:hover:text-stone-50"
          >
            <LucideIcon icon={icon} size={16} class="h-4 w-4 shrink-0 opacity-80" />
            <span data-desktop-nav-label class="whitespace-nowrap">{label}</span>
          </a>
        ))}
      </nav>
    </div>

    <div data-header-actions class="flex shrink-0 items-center gap-3">
      <button
        id="theme-toggle"
        type="button"
        data-testid="theme-toggle"
        data-label-dark={t('theme.switch_to_dark')}
        data-label-light={t('theme.switch_to_light')}
        class="inline-flex h-9 w-9 items-center justify-center rounded-lg border border-stone-200 text-stone-600 transition-colors hover:bg-stone-100 hover:text-stone-900 dark:border-stone-800 dark:text-stone-300 dark:hover:bg-stone-800 dark:hover:text-stone-50"
        aria-label={t('theme.switch_to_dark')}
        aria-pressed="false"
      >
        <svg
          data-theme-icon="moon"
          class="h-4 w-4"
          fill="none"
          viewBox="0 0 24 24"
          stroke="currentColor"
          stroke-width="2"
          aria-hidden="true"
        >
          <path stroke-linecap="round" stroke-linejoin="round" d="M21 12.79A9 9 0 1 1 11.21 3a7 7 0 0 0 9.79 9.79z" />
        </svg>
        <svg
          data-theme-icon="sun"
          class="hidden h-4 w-4"
          fill="none"
          viewBox="0 0 24 24"
          stroke="currentColor"
          stroke-width="2"
          aria-hidden="true"
        >
          <circle cx="12" cy="12" r="4" />
          <path d="M12 2v2" />
          <path d="M12 20v2" />
          <path d="m4.93 4.93 1.41 1.41" />
          <path d="m17.66 17.66 1.41 1.41" />
          <path d="M2 12h2" />
          <path d="M20 12h2" />
          <path d="m6.34 17.66-1.41 1.41" />
          <path d="m19.07 4.93-1.41 1.41" />
        </svg>
        <span class="sr-only">{t('theme.toggle')}</span>
      </button>

      {/* Language switcher */}
      <div class="flex items-center gap-1 rounded-lg border border-stone-200 p-0.5 dark:border-stone-800">
        {Object.entries(languages).map(([code, name]) => (
          <a
            href={getLanguageSwitchPath(currentPath, code)}
            class:list={[
              'rounded-md px-2 py-1 text-xs font-medium transition-colors',
              lang === code
                ? 'bg-stone-900 text-white dark:bg-stone-100 dark:text-stone-900'
                : 'text-stone-500 hover:text-stone-900 dark:hover:text-stone-100',
            ]}
          >
            {name}
          </a>
        ))}
      </div>

      <a
        href={githubRepoUrl}
        target="_blank"
        rel="noopener noreferrer"
        data-github-link
        class="hidden h-9 items-center gap-2 rounded-lg border border-stone-200 bg-stone-50/80 px-3 text-sm font-medium text-stone-600 transition-colors hover:bg-stone-100 hover:text-stone-900 md:inline-flex dark:border-stone-800 dark:bg-stone-900/70 dark:text-stone-300 dark:hover:bg-stone-800 dark:hover:text-stone-50"
        aria-label={t('nav.github_repo_aria')}
        title="GitHub"
      >
        <svg class="h-4 w-4 shrink-0" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M12 .5a12 12 0 0 0-3.79 23.39c.6.11.82-.26.82-.58v-2.03c-3.34.73-4.04-1.61-4.04-1.61-.55-1.38-1.33-1.75-1.33-1.75-1.08-.74.08-.73.08-.73 1.2.08 1.82 1.22 1.82 1.22 1.06 1.81 2.79 1.29 3.47.99.11-.77.42-1.29.76-1.59-2.67-.3-5.47-1.33-5.47-5.92 0-1.31.47-2.38 1.22-3.22-.12-.3-.53-1.52.12-3.16 0 0 1-.32 3.27 1.23a11.4 11.4 0 0 1 5.95 0c2.27-1.55 3.27-1.23 3.27-1.23.65 1.64.24 2.86.12 3.16.76.84 1.22 1.91 1.22 3.22 0 4.6-2.81 5.62-5.49 5.92.43.37.81 1.1.81 2.22v3.29c0 .32.22.69.83.57A12 12 0 0 0 12 .5z" />
        </svg>
        <span data-github-label>GitHub</span>
      </a>

      {/* Mobile menu button */}
      <button
        id="mobile-menu-btn"
        class="inline-flex items-center justify-center rounded-lg p-2 text-stone-600 hover:bg-stone-100 md:hidden dark:text-stone-400 dark:hover:bg-stone-800"
        aria-label="Menu"
      >
        <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
      </button>
    </div>
  </div>

  {/* Mobile menu */}
  <div id="mobile-menu" class="hidden border-t border-stone-200 bg-stone-50 md:hidden dark:border-stone-800 dark:bg-stone-950">
    <div class={mobileMenuContainerClass}>
      {navItems.map(({ href, label, icon }) => (
        <a
          href={href}
          class="flex items-center gap-2 rounded-lg px-3 py-2.5 text-sm text-stone-600 hover:bg-stone-100 hover:text-stone-900 dark:text-stone-400 dark:hover:bg-stone-800 dark:hover:text-stone-50"
        >
          <LucideIcon icon={icon} size={16} class="h-4 w-4 shrink-0 opacity-80" />
          {label}
        </a>
      ))}
      <a
        href={githubRepoUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="flex items-center gap-2 rounded-lg px-3 py-2.5 text-sm text-stone-600 hover:bg-stone-100 hover:text-stone-900 dark:text-stone-400 dark:hover:bg-stone-800 dark:hover:text-stone-50"
        aria-label={t('nav.github_repo_aria')}
      >
        <svg class="h-4 w-4 shrink-0" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M12 .5a12 12 0 0 0-3.79 23.39c.6.11.82-.26.82-.58v-2.03c-3.34.73-4.04-1.61-4.04-1.61-.55-1.38-1.33-1.75-1.33-1.75-1.08-.74.08-.73.08-.73 1.2.08 1.82 1.22 1.82 1.22 1.06 1.81 2.79 1.29 3.47.99.11-.77.42-1.29.76-1.59-2.67-.3-5.47-1.33-5.47-5.92 0-1.31.47-2.38 1.22-3.22-.12-.3-.53-1.52.12-3.16 0 0 1-.32 3.27 1.23a11.4 11.4 0 0 1 5.95 0c2.27-1.55 3.27-1.23 3.27-1.23.65 1.64.24 2.86.12 3.16.76.84 1.22 1.91 1.22 3.22 0 4.6-2.81 5.62-5.49 5.92.43.37.81 1.1.81 2.22v3.29c0 .32.22.69.83.57A12 12 0 0 0 12 .5z" />
        </svg>
        <span>GitHub</span>
      </a>
    </div>
  </div>
</header>

<style>
  header[data-desktop-nav-state='icon'] [data-desktop-nav] {
    gap: 0.25rem;
  }

  header[data-desktop-nav-state='icon'] [data-desktop-nav-link] {
    justify-content: center;
    padding-left: 0.75rem;
    padding-right: 0.75rem;
  }

  header[data-desktop-nav-state='icon'] [data-desktop-nav-label] {
    display: none;
  }

  header[data-desktop-nav-state='icon'] [data-github-link] {
    gap: 0;
    justify-content: center;
    padding-left: 0.75rem;
    padding-right: 0.75rem;
  }

  header[data-desktop-nav-state='icon'] [data-github-label] {
    display: none;
  }
</style>

<script>
  const HEADER_STATE_KEY = '__exomindHeaderLifecycle';
  const THEME_STORAGE_KEY = 'exomind-theme';

  const updateThemeButton = () => {
    const themeToggle = document.getElementById('theme-toggle');
    const moonIcon = themeToggle?.querySelector('[data-theme-icon="moon"]');
    const sunIcon = themeToggle?.querySelector('[data-theme-icon="sun"]');
    const darkModeLabel = themeToggle?.getAttribute('data-label-dark') ?? 'Switch to dark mode';
    const lightModeLabel = themeToggle?.getAttribute('data-label-light') ?? 'Switch to light mode';
    const isDark = document.documentElement.classList.contains('dark');

    themeToggle?.setAttribute('aria-pressed', isDark ? 'true' : 'false');
    themeToggle?.setAttribute('aria-label', isDark ? lightModeLabel : darkModeLabel);
    moonIcon?.classList.toggle('hidden', isDark);
    sunIcon?.classList.toggle('hidden', !isDark);
  };

  const updateDesktopNavState = () => {
    const header = document.querySelector('[data-site-header]');
    const row = document.querySelector('[data-header-row]');
    const brand = document.querySelector('[data-header-brand]');
    const nav = document.querySelector('[data-desktop-nav]');
    const actions = document.querySelector('[data-header-actions]');

    if (
      !(header instanceof HTMLElement) ||
      !(row instanceof HTMLElement) ||
      !(brand instanceof HTMLElement) ||
      !(nav instanceof HTMLElement) ||
      !(actions instanceof HTMLElement)
    ) {
      return;
    }

    if (window.innerWidth < 768) {
      header.dataset.desktopNavState = 'full';
      return;
    }

    header.dataset.desktopNavState = 'full';

    const rowWidth = row.getBoundingClientRect().width;
    const brandWidth = brand.getBoundingClientRect().width;
    const actionsWidth = actions.getBoundingClientRect().width;
    const availableWidth = Math.max(0, rowWidth - brandWidth - actionsWidth - 32);
    const navWidth = nav.scrollWidth;

    header.dataset.desktopNavState = navWidth > availableWidth ? 'icon' : 'full';
  };

  const bindHeaderInteractions = () => {
    const btn = document.getElementById('mobile-menu-btn');
    const menu = document.getElementById('mobile-menu');
    const themeToggle = document.getElementById('theme-toggle');

    if (btn && !btn.dataset.bound) {
      btn.addEventListener('click', () => {
        menu?.classList.toggle('hidden');
      });
      btn.dataset.bound = 'true';
    }

    if (themeToggle && !themeToggle.dataset.bound) {
      themeToggle.addEventListener('click', () => {
        const nextTheme = document.documentElement.classList.contains('dark') ? 'light' : 'dark';
        window.__applyExomindTheme?.(nextTheme, true);
        updateThemeButton();
      });
      themeToggle.dataset.bound = 'true';
    }

    menu?.classList.add('hidden');
    updateThemeButton();
    window.requestAnimationFrame(() => updateDesktopNavState());
  };

  if (!window[HEADER_STATE_KEY]) {
    const mediaQuery = window.matchMedia('(prefers-color-scheme: dark)');

    const handleThemePreferenceChange = (event) => {
      let storedTheme = null;
      try {
        storedTheme = window.localStorage.getItem(THEME_STORAGE_KEY);
      } catch {
        storedTheme = null;
      }
      if (storedTheme === 'dark' || storedTheme === 'light') {
        return;
      }
      window.__applyExomindTheme?.(event.matches ? 'dark' : 'light', false);
      updateThemeButton();
    };

    mediaQuery.addEventListener?.('change', handleThemePreferenceChange);
    document.addEventListener('astro:page-load', bindHeaderInteractions);
    document.addEventListener('astro:after-swap', () => {
      updateThemeButton();
      updateDesktopNavState();
    });
    window.addEventListener('resize', updateDesktopNavState);

    window[HEADER_STATE_KEY] = true;
  }

  bindHeaderInteractions();
</script>
