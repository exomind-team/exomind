---
import DocsShell from "../../components/docs/DocsShell.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getDocsPages, getDocsPage, type DocSlug } from "../../lib/docs";

export function getStaticPaths() {
  return getDocsPages("zh").map((page) => ({
    params: { slug: page.slug },
  }));
}

const slug = Astro.params.slug as DocSlug;
const page = getDocsPage("zh", slug);
const missingPageCopy = {
  title: "文档不存在",
  description: "你访问的这篇内容不在当前文档中。",
};

if (!page) {
  Astro.response.status = 404;
}
---

<BaseLayout title={page?.title ?? missingPageCopy.title} description={page?.description ?? missingPageCopy.description}>
  {page ? (
    <DocsShell lang="zh" page={page} />
  ) : (
    <section class="pt-32 pb-24">
      <div class="section-container">
        <div class="mx-auto max-w-2xl rounded-[32px] border border-stone-200 bg-white p-8 shadow-sm dark:border-stone-800 dark:bg-stone-900 md:p-10">
          <p class="text-xs font-semibold uppercase tracking-[0.24em] text-brand/80">
            Documentation / 文档
          </p>
          <h1 class="mt-4 text-3xl font-semibold tracking-tight text-stone-900 dark:text-stone-50">
            这篇内容不在当前文档里
          </h1>
          <p class="mt-4 text-base leading-relaxed text-stone-500 dark:text-stone-400">
            当前文档只保留按任务组织的正文页面。你访问的这个地址已经不再作为文档页继续维护。
          </p>
          <div class="mt-8 flex flex-wrap gap-3">
            <a href="/docs" class="btn-primary px-6 py-3 text-base">
              回到文档
            </a>
            <a href="/getting-started" class="btn-secondary px-6 py-3 text-base">
              打开独立起步页
            </a>
          </div>
        </div>
      </div>
    </section>
  )}
</BaseLayout>
