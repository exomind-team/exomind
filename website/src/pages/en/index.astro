---
import { Dot, Sparkles } from "lucide-static";
import BaseLayout from '../../layouts/BaseLayout.astro';
import LucideIcon from '../../components/LucideIcon.astro';
import SmartDownloadLink from '../../components/SmartDownloadLink.astro';
import { getLocalizedPath, useTranslations } from '../../i18n';

const t = useTranslations('en');
const featuresPath = getLocalizedPath('/features', 'en');
const versionLogPath = getLocalizedPath('/changelog', 'en');
const heroHighlights = ['Durable Thread', 'Agent Runtime', 'Clear Boundaries'];

const capabilityLayers = [
  {
    eyebrow: 'Growth Layer',
    title: 'Turn lived experience into resumable context',
    description:
      'Voice notes, event logs, time blocks, and tasks work together so what happened, what is in motion, and what comes next stay connected.',
    icon: 'growth',
    points: [
      'Keep raw events and reflections close to the source',
      'Turn time and tasks into a rhythm you can actually resume',
    ],
  },
  {
    eyebrow: 'Runtime Layer',
    title: 'Bring agents into the loop without replacing you',
    description:
      'The terminal workbench and customizable signal network let agents participate in real workflows while budgets, permissions, and capabilities stay defined by you.',
    icon: 'runtime',
    points: [
      'Use the terminal workbench for real operational threads',
      'Connect signal-driven automation to personal growth workflows',
    ],
  },
  {
    eyebrow: 'Infrastructure Layer',
    title: 'Keep the same thread alive across devices and hosts',
    description:
      'Local-first storage, archive isolation, and distributed multi-device connectivity make ExoMind cognitive infrastructure you own instead of a stack of cloud copies.',
    icon: 'infrastructure',
    points: [
      'Local archives and isolation carry long-term memory',
      'Distributed continuation keeps one thread moving across surfaces',
    ],
  },
];

const workflowSteps = [
  {
    title: 'Capture',
    description: 'Record events, time, and tasks so the thread begins from what actually happened.',
  },
  {
    title: 'Orchestrate',
    description: 'Bring tools and agents into the flow within the boundaries you define.',
  },
  {
    title: 'Continue',
    description: 'Move between terminal, structured interface, and devices without rebuilding context.',
  },
];

const trustPillars = [
  {
    value: 'Local-first',
    label: 'memory stays in your own devices and archives',
  },
  {
    value: 'Archive isolation',
    label: 'projects, identities, and contexts stay separated on purpose',
  },
  {
    value: 'Distributed continuation',
    label: 'the same thread keeps going across devices',
  },
];
---

<BaseLayout title="Home">
  <section class="relative overflow-hidden pb-24 pt-32">
    <div class="section-container relative z-10">
      <div class="mx-auto max-w-3xl text-center">
        <div class="mb-6 inline-flex items-center gap-2 rounded-full border border-stone-200 bg-white/80 px-4 py-1.5 text-sm text-stone-600 backdrop-blur dark:border-stone-800 dark:bg-stone-900/80 dark:text-stone-400">
          <LucideIcon icon={Sparkles} size={14} class="h-3.5 w-3.5 shrink-0 text-brand" />
          {heroHighlights.map((item, index) => (
            <Fragment>
              {index > 0 && (
                <LucideIcon
                  icon={Dot}
                  size={14}
                  class="h-3.5 w-3.5 shrink-0 text-stone-400 dark:text-stone-500"
                />
              )}
              <span>{item}</span>
            </Fragment>
          ))}
        </div>
        <h1 class="heading-display text-5xl leading-tight text-stone-900 sm:text-6xl lg:text-7xl dark:text-stone-50">
          ExoMind is the exoskeleton of your cognition.
        </h1>
        <p class="mt-6 text-lg leading-relaxed text-stone-500 sm:text-xl">
          Keep the same thread of work going across terminal, structured interface, and devices instead of starting from scratch each time.
        </p>
        <div class="mt-10 flex flex-col items-center justify-center gap-4 sm:flex-row">
          <SmartDownloadLink lang="en" class="btn-primary px-8 py-3.5 text-base" label={t('hero.cta.download')}>
            {t('hero.cta.download')}
          </SmartDownloadLink>
          <a href={featuresPath} class="btn-secondary px-8 py-3.5 text-base">
            {t('hero.cta.learn')}
          </a>
        </div>
      </div>
    </div>
    <div class="absolute inset-0 -z-10">
      <div class="absolute left-1/2 top-0 h-[600px] w-[600px] -translate-x-1/2 -translate-y-1/2 rounded-full bg-brand/5 blur-3xl"></div>
    </div>
  </section>

  <section class="bg-stone-100/50 py-24 dark:bg-stone-900/30">
    <div class="section-container">
      <div class="mx-auto max-w-3xl text-center">
        <p class="text-xs font-semibold uppercase tracking-[0.24em] text-brand/80">Positioning</p>
        <h2 class="mt-4 heading-display text-3xl text-stone-900 sm:text-4xl dark:text-stone-50">
          Not another AI app, but distributed cognitive infrastructure
        </h2>
        <p class="mt-4 text-stone-500 sm:text-lg">
          ExoMind spans personal growth, controlled agent runtime, and cross-device continuation so one thread of work can keep going.
        </p>
      </div>
      <div class="mt-16 grid gap-6 lg:grid-cols-3">
        {capabilityLayers.map((layer) => (
          <article class="card flex h-full flex-col rounded-3xl border border-stone-200/80 bg-white/90 p-8 shadow-sm dark:border-stone-800 dark:bg-stone-900/90">
            <div class="flex h-12 w-12 items-center justify-center rounded-2xl bg-brand-50 text-brand dark:bg-brand-900/30">
              {layer.icon === 'growth' && (
                <svg class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M12 20V10" />
                  <path d="M18 20V4" />
                  <path d="M6 20v-4" />
                  <path d="M4 20h16" />
                </svg>
              )}
              {layer.icon === 'runtime' && (
                <svg class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M12 8V4H8" />
                  <rect width="16" height="12" x="4" y="8" rx="2" />
                  <path d="M2 14h2" />
                  <path d="M20 14h2" />
                  <path d="M15 13v2" />
                  <path d="M9 13v2" />
                </svg>
              )}
              {layer.icon === 'infrastructure' && (
                <svg class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <rect width="20" height="6" x="2" y="4" rx="2" />
                  <rect width="20" height="6" x="2" y="14" rx="2" />
                  <path d="M6 7h.01" />
                  <path d="M6 17h.01" />
                  <path d="M10 7h8" />
                  <path d="M10 17h8" />
                </svg>
              )}
            </div>
            <p class="mt-6 text-xs font-semibold uppercase tracking-[0.22em] text-brand/80">{layer.eyebrow}</p>
            <h3 class="mt-3 text-xl font-semibold text-stone-900 dark:text-stone-50">{layer.title}</h3>
            <p class="mt-3 text-sm leading-relaxed text-stone-500">{layer.description}</p>
            <ul class="mt-6 space-y-3 text-sm text-stone-600 dark:text-stone-300">
              {layer.points.map((point) => (
                <li class="flex items-start gap-3">
                  <span class="mt-1 h-2 w-2 shrink-0 rounded-full bg-brand"></span>
                  <span>{point}</span>
                </li>
              ))}
            </ul>
          </article>
        ))}
      </div>
      <div class="mt-12 text-center">
        <a href={featuresPath} class="inline-flex items-center gap-2 font-medium text-brand transition-colors hover:text-brand-600">
          View all features
          <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M5 12h14" />
            <path d="m12 5 7 7-7 7" />
          </svg>
        </a>
      </div>
    </div>
  </section>

  <section class="py-24">
    <div class="section-container">
      <div class="mx-auto max-w-3xl text-center">
        <p class="text-xs font-semibold uppercase tracking-[0.24em] text-brand/80">Workflow</p>
        <h2 class="mt-4 heading-display text-3xl text-stone-900 sm:text-4xl dark:text-stone-50">
          How one thread of work keeps going
        </h2>
        <p class="mt-4 text-stone-500 sm:text-lg">
          The point is not an autonomous subject living for you. The point is extending, continuing, and protecting your own cognition.
        </p>
      </div>
      <div class="relative mx-auto mt-16 max-w-5xl">
        <div class="absolute left-[calc(16.67%-1px)] right-[calc(16.67%-1px)] top-8 hidden h-0.5 border-t-2 border-dashed border-stone-200 dark:border-stone-700 sm:block"></div>
        <div class="grid gap-10 sm:grid-cols-3 sm:gap-8">
          {workflowSteps.map((step, index) => (
            <div class="relative text-center">
              <div class="relative mx-auto flex h-16 w-16 items-center justify-center rounded-full bg-brand text-xl font-bold text-white">
                {index + 1}
              </div>
              <h3 class="mt-6 text-lg font-semibold text-stone-900 dark:text-stone-50">{step.title}</h3>
              <p class="mt-3 text-sm leading-relaxed text-stone-500">{step.description}</p>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <section class="bg-stone-100/50 py-24 dark:bg-stone-900/30">
    <div class="section-container">
      <div class="mx-auto max-w-3xl text-center">
        <p class="text-xs font-semibold uppercase tracking-[0.24em] text-brand/80">Boundaries</p>
        <h2 class="mt-4 heading-display text-3xl text-stone-900 sm:text-4xl dark:text-stone-50">
          Establish the boundary before automation
        </h2>
        <p class="mt-4 text-stone-500 sm:text-lg">
          ExoMind grounds durable work in local-first archives, archive isolation, and distributed multi-device continuation. What comes back is your work, not a temporary window.
        </p>
      </div>
      <div class="mt-12 grid gap-6 sm:grid-cols-3">
        {trustPillars.map((pillar) => (
          <div class="rounded-2xl border border-stone-200 bg-white p-8 text-center dark:border-stone-800 dark:bg-stone-900">
            <div class="text-3xl font-bold text-brand">{pillar.value}</div>
            <div class="mt-2 text-sm text-stone-500">{pillar.label}</div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="py-24">
    <div class="section-container">
      <div class="mx-auto max-w-2xl text-center">
        <p class="text-xs font-semibold uppercase tracking-[0.24em] text-brand/80">Download</p>
        <h2 class="mt-4 heading-display text-3xl text-stone-900 sm:text-4xl dark:text-stone-50">
          Download the stable build and start your first durable thread
        </h2>
        <p class="mt-4 text-stone-500 sm:text-lg">
          The homepage delivers the latest stable build for your current system. Use the version log when you need release notes or history.
        </p>
        <div class="mt-10 flex flex-col items-center justify-center gap-4 sm:flex-row">
          <SmartDownloadLink lang="en" class="btn-primary px-8 py-3.5 text-base" label="Download Now">
            Download Now
          </SmartDownloadLink>
          <a href={versionLogPath} class="btn-secondary px-8 py-3.5 text-base">
            Version Log
          </a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
