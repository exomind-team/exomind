---
import BaseLayout from '../layouts/BaseLayout.astro';
import { useTranslations } from '../i18n';

const t = useTranslations('zh');

const features = [
  {
    title: t('features.eventlog.title'),
    desc: t('features.eventlog.desc'),
    icon: 'bookopen',
  },
  {
    title: t('features.timeblock.title'),
    desc: t('features.timeblock.desc'),
    icon: 'timer',
  },
  {
    title: t('features.tasks.title'),
    desc: t('features.tasks.desc'),
    icon: 'listchecks',
  },
  {
    title: t('features.agents.title'),
    desc: t('features.agents.desc'),
    icon: 'bot',
  },
  {
    title: t('features.privacy.title'),
    desc: t('features.privacy.desc'),
    icon: 'shield',
  },
  {
    title: t('features.crossplatform.title'),
    desc: t('features.crossplatform.desc'),
    icon: 'monitor',
  },
];
---

<BaseLayout title="功能">
  {/* Hero */}
  <section class="relative overflow-hidden pt-32 pb-16">
    <div class="section-container relative z-10">
      <div class="mx-auto max-w-3xl text-center">
        <h1 class="heading-display text-5xl leading-tight text-stone-900 sm:text-6xl dark:text-stone-50">
          {t('features.title')}
        </h1>
        <p class="mt-6 text-lg leading-relaxed text-stone-500 sm:text-xl">
          {t('features.subtitle')}
        </p>
      </div>
    </div>
    <div class="absolute inset-0 -z-10">
      <div class="absolute left-1/2 top-0 h-[600px] w-[600px] -translate-x-1/2 -translate-y-1/2 rounded-full bg-brand/5 blur-3xl"></div>
    </div>
  </section>

  {/* Feature Grid */}
  <section class="pb-20">
    <div class="section-container">
      <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {features.map((feature) => (
          <div class="card group hover:-translate-y-1 transition-all duration-300">
            <div class="mb-4 flex h-12 w-12 items-center justify-center rounded-xl bg-brand/10 text-brand">
              {feature.icon === 'bookopen' && (
                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"/>
                  <path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"/>
                </svg>
              )}
              {feature.icon === 'timer' && (
                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <line x1="10" x2="14" y1="2" y2="2"/>
                  <line x1="12" x2="15" y1="14" y2="11"/>
                  <circle cx="12" cy="14" r="8"/>
                </svg>
              )}
              {feature.icon === 'listchecks' && (
                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="m3 17 2 2 4-4"/>
                  <path d="m3 7 2 2 4-4"/>
                  <path d="M13 6h8"/>
                  <path d="M13 12h8"/>
                  <path d="M13 18h8"/>
                </svg>
              )}
              {feature.icon === 'bot' && (
                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M12 8V4H8"/>
                  <rect width="16" height="12" x="4" y="8" rx="2"/>
                  <path d="M2 14h2"/>
                  <path d="M20 14h2"/>
                  <path d="M15 13v2"/>
                  <path d="M9 13v2"/>
                </svg>
              )}
              {feature.icon === 'shield' && (
                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z"/>
                </svg>
              )}
              {feature.icon === 'monitor' && (
                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <rect width="20" height="14" x="2" y="3" rx="2"/>
                  <line x1="8" x2="16" y1="21" y2="21"/>
                  <line x1="12" x2="12" y1="17" y2="21"/>
                </svg>
              )}
            </div>
            <h3 class="text-lg font-semibold text-stone-900 dark:text-stone-50">{feature.title}</h3>
            <p class="mt-2 text-sm leading-relaxed text-stone-500 dark:text-stone-400">{feature.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  {/* CTA */}
  <section class="pb-24">
    <div class="section-container">
      <div class="rounded-2xl bg-stone-900 px-8 py-16 text-center dark:bg-stone-800">
        <h2 class="heading-display text-3xl text-white sm:text-4xl">{t('features.cta.title')}</h2>
        <p class="mt-4 text-stone-400">{t('features.cta.desc')}</p>
        <div class="mt-8">
          <a href="/download" class="btn-primary px-8 py-3.5 text-base">
            {t('features.cta.download')}
          </a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
