# EditorConfig is awesome: https://EditorConfig.org

# Top-most EditorConfig file
root = true

# Default to LF across the repo; keep explicit Windows-only exceptions in .gitattributes
[*]
end_of_line = lf
insert_final_newline = true
charset = utf-8
trim_trailing_whitespace = true

# TypeScript / JavaScript
[*.{ts,tsx,js,jsx}]
indent_style = space
indent_size = 2

# JSON
[*.json]
indent_style = space
indent_size = 2

# YAML
[*.{yml,yaml}]
indent_style = space
indent_size = 2

# Markdown
[*.md]
trim_trailing_whitespace = false

# CSS / SCSS / Tailwind
[*.{css,scss}]
indent_style = space
indent_size = 2

# Rust
[*.rs]
indent_style = space
indent_size = 4

# Tauri config
[tauri.conf.json]
indent_style = space
indent_size = 2
