{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "beta",
  "description": "Isolated Beta main window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "opener:default",
    "clipboard-manager:allow-read-text",
    "clipboard-manager:allow-write-text",
    "core:window:allow-set-fullscreen",
    "mcp-bridge:default",
    "log:default"
  ]
}
