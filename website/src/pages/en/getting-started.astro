---
import BaseLayout from "../../layouts/BaseLayout.astro";

const targetPath = "/getting-started";
---

<BaseLayout
  title="Getting Started"
  description="The standalone getting started guide is currently available in Chinese."
>
  <section class="pt-32 pb-24">
    <div class="section-container">
      <div class="mx-auto max-w-2xl rounded-[32px] border border-stone-200 bg-white p-8 text-center shadow-sm dark:border-stone-800 dark:bg-stone-900 md:p-10">
        <p class="text-xs font-semibold uppercase tracking-[0.24em] text-brand/80">
          Getting Started
        </p>
        <h1 class="heading-display mt-4 text-3xl text-stone-900 sm:text-4xl dark:text-stone-50">
          The standalone guide is currently in Chinese
        </h1>
        <p class="mt-4 text-base leading-relaxed text-stone-500">
          The getting started page is no longer part of the docs tree.
          Until an English version is ready, you can use the standalone Chinese page at
          <span class="font-medium text-stone-700 dark:text-stone-200"> /getting-started</span>.
        </p>
        <div class="mt-8">
          <a href={targetPath} class="btn-primary px-8 py-3 text-base">
            Open the standalone guide
          </a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
