---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { useTranslations } from '../../i18n';

const t = useTranslations('en');
---

<BaseLayout title={t('about.title')}>
  {/* Hero */}
  <section class="relative overflow-hidden pt-32 pb-16">
    <div class="section-container relative z-10">
      <div class="mx-auto max-w-3xl text-center">
        <h1 class="heading-display text-4xl leading-tight text-stone-900 sm:text-5xl lg:text-6xl dark:text-stone-50">
          {t('about.title')}
        </h1>
        <p class="mt-4 text-lg leading-relaxed text-stone-500">
          {t('about.subtitle')}
        </p>
      </div>
    </div>
    <div class="absolute inset-0 -z-10">
      <div class="absolute left-1/2 top-0 h-[500px] w-[500px] -translate-x-1/2 -translate-y-1/2 rounded-full bg-brand/5 blur-3xl"></div>
    </div>
  </section>

  {/* Cards */}
  <section class="pb-16">
    <div class="section-container">
      <div class="mx-auto grid max-w-5xl gap-6 md:grid-cols-3">
        {/* Mission */}
        <div class="card flex flex-col items-start gap-4 p-8">
          <div class="flex h-10 w-10 items-center justify-center rounded-lg bg-brand-50 dark:bg-brand-900/20">
            <svg class="h-5 w-5 text-brand" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <circle cx="12" cy="12" r="10" /><circle cx="12" cy="12" r="6" /><circle cx="12" cy="12" r="2" />
            </svg>
          </div>
          <h2 class="text-lg font-semibold text-stone-900 dark:text-stone-50">
            {t('about.mission.title')}
          </h2>
          <p class="text-sm leading-relaxed text-stone-500">
            {t('about.mission.desc')}
          </p>
        </div>

        {/* Philosophy */}
        <div class="card flex flex-col items-start gap-4 p-8">
          <div class="flex h-10 w-10 items-center justify-center rounded-lg bg-brand-50 dark:bg-brand-900/20">
            <svg class="h-5 w-5 text-brand" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path d="M15 14c.2-1 .7-1.7 1.5-2.5 1-.9 1.5-2.2 1.5-3.5A6 6 0 0 0 6 8c0 1 .2 2.2 1.5 3.5.7.7 1.3 1.5 1.5 2.5" /><path d="M9 18h6" /><path d="M10 22h4" />
            </svg>
          </div>
          <h2 class="text-lg font-semibold text-stone-900 dark:text-stone-50">
            {t('about.philosophy.title')}
          </h2>
          <p class="text-sm leading-relaxed text-stone-500">
            {t('about.philosophy.desc')}
          </p>
        </div>

        {/* Open Source */}
        <div class="card flex flex-col items-start gap-4 p-8">
          <div class="flex h-10 w-10 items-center justify-center rounded-lg bg-brand-50 dark:bg-brand-900/20">
            <svg class="h-5 w-5 text-brand" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4" /><path d="M9 18c-4.51 2-5-2-7-2" />
            </svg>
          </div>
          <h2 class="text-lg font-semibold text-stone-900 dark:text-stone-50">
            {t('about.opensource.title')}
          </h2>
          <p class="text-sm leading-relaxed text-stone-500">
            {t('about.opensource.desc')}
          </p>
          <a
            href="https://github.com/exomind-team/exomind"
            target="_blank"
            rel="noopener"
            class="mt-auto text-sm font-medium text-brand hover:text-brand-600 transition-colors"
          >
            GitHub &rarr;
          </a>
        </div>
      </div>
    </div>
  </section>

  {/* Naming & Vision / 命名与愿景 */}
  <section class="pb-16">
    <div class="section-container">
      <div class="mx-auto max-w-4xl">
        <div class="card p-8 md:p-10">
          <p class="text-sm font-medium uppercase tracking-[0.22em] text-brand">
            {t('about.brand.eyebrow')}
          </p>
          <h2 class="heading-display mt-3 text-3xl leading-tight text-stone-900 sm:text-4xl dark:text-stone-50">
            {t('about.brand.title')}
          </h2>
          <p class="mt-4 max-w-3xl text-base leading-relaxed text-stone-500">
            {t('about.brand.desc')}
          </p>

          <div class="mt-8 grid gap-4 md:grid-cols-3">
            <div class="rounded-2xl border border-stone-200 bg-stone-50 p-5 dark:border-stone-800 dark:bg-stone-950">
              <p class="text-base font-semibold text-stone-900 dark:text-stone-50">{t('about.brand.line1')}</p>
              <p class="mt-2 text-sm leading-relaxed text-stone-500">{t('about.brand.line1_note')}</p>
            </div>
            <div class="rounded-2xl border border-stone-200 bg-stone-50 p-5 dark:border-stone-800 dark:bg-stone-950">
              <p class="text-base font-semibold text-stone-900 dark:text-stone-50">{t('about.brand.line2')}</p>
              <p class="mt-2 text-sm leading-relaxed text-stone-500">{t('about.brand.line2_note')}</p>
            </div>
            <div class="rounded-2xl border border-stone-200 bg-stone-50 p-5 dark:border-stone-800 dark:bg-stone-950">
              <p class="text-base font-semibold text-stone-900 dark:text-stone-50">{t('about.brand.line3')}</p>
              <p class="mt-2 text-sm leading-relaxed text-stone-500">{t('about.brand.line3_note')}</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  {/* Quote */}
  <section class="pb-24">
    <div class="section-container">
      <div class="mx-auto max-w-3xl text-center">
        <blockquote class="relative px-8">
          <span class="absolute -top-4 left-0 text-6xl leading-none text-brand/20 select-none" aria-hidden="true">&ldquo;</span>
          <p class="heading-display text-2xl italic leading-relaxed text-stone-700 sm:text-3xl dark:text-stone-300">
            Life is not an entity or state, but a process that continuously unfolds in time.
          </p>
          <span class="absolute -bottom-8 right-0 text-6xl leading-none text-brand/20 select-none" aria-hidden="true">&rdquo;</span>
        </blockquote>
      </div>
    </div>
  </section>
</BaseLayout>
