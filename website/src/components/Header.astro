---
import { getLangFromUrl, useTranslations, languages, getLocalizedPath } from '../i18n';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const currentPath = Astro.url.pathname;

const navItems = [
  { href: '/features', label: t('nav.features') },
  { href: '/download', label: t('nav.download') },
  { href: '/changelog', label: t('nav.changelog') },
  { href: '/docs', label: t('nav.docs') },
  { href: '/about', label: t('nav.about') },
];
---

<header class="fixed top-0 z-50 w-full border-b border-stone-200/60 bg-stone-50/80 backdrop-blur-xl dark:border-stone-800/60 dark:bg-stone-950/80">
  <div class="section-container flex h-16 items-center justify-between">
    <a href={getLocalizedPath('/', lang)} class="flex items-center gap-2.5">
      <div class="flex h-8 w-8 items-center justify-center rounded-lg bg-brand">
        <span class="text-sm font-bold text-white">E</span>
      </div>
      <span class="text-lg font-semibold tracking-tight text-stone-900 dark:text-stone-50">ExoMind</span>
    </a>

    <nav class="hidden items-center gap-1 md:flex">
      {navItems.map(({ href, label }) => (
        <a
          href={getLocalizedPath(href, lang)}
          class="rounded-lg px-3 py-2 text-sm text-stone-600 transition-colors hover:bg-stone-100 hover:text-stone-900 dark:text-stone-400 dark:hover:bg-stone-800 dark:hover:text-stone-50"
        >
          {label}
        </a>
      ))}
    </nav>

    <div class="flex items-center gap-3">
      <button
        id="theme-toggle"
        type="button"
        data-testid="theme-toggle"
        data-label-dark={t('theme.switch_to_dark')}
        data-label-light={t('theme.switch_to_light')}
        class="inline-flex h-9 w-9 items-center justify-center rounded-lg border border-stone-200 text-stone-600 transition-colors hover:bg-stone-100 hover:text-stone-900 dark:border-stone-800 dark:text-stone-300 dark:hover:bg-stone-800 dark:hover:text-stone-50"
        aria-label={t('theme.switch_to_dark')}
        aria-pressed="false"
      >
        <svg
          data-theme-icon="moon"
          class="h-4 w-4"
          fill="none"
          viewBox="0 0 24 24"
          stroke="currentColor"
          stroke-width="2"
          aria-hidden="true"
        >
          <path stroke-linecap="round" stroke-linejoin="round" d="M21 12.79A9 9 0 1 1 11.21 3a7 7 0 0 0 9.79 9.79z" />
        </svg>
        <svg
          data-theme-icon="sun"
          class="hidden h-4 w-4"
          fill="none"
          viewBox="0 0 24 24"
          stroke="currentColor"
          stroke-width="2"
          aria-hidden="true"
        >
          <circle cx="12" cy="12" r="4" />
          <path d="M12 2v2" />
          <path d="M12 20v2" />
          <path d="m4.93 4.93 1.41 1.41" />
          <path d="m17.66 17.66 1.41 1.41" />
          <path d="M2 12h2" />
          <path d="M20 12h2" />
          <path d="m6.34 17.66-1.41 1.41" />
          <path d="m19.07 4.93-1.41 1.41" />
        </svg>
        <span class="sr-only">{t('theme.toggle')}</span>
      </button>

      {/* Language switcher */}
      <div class="flex items-center gap-1 rounded-lg border border-stone-200 p-0.5 dark:border-stone-800">
        {Object.entries(languages).map(([code, name]) => (
          <a
            href={code === 'zh' ? currentPath.replace(/^\/en(\/|$)/, '/') || '/' : currentPath.startsWith('/en') ? currentPath : `/en${currentPath}`}
            class:list={[
              'rounded-md px-2 py-1 text-xs font-medium transition-colors',
              lang === code
                ? 'bg-stone-900 text-white dark:bg-stone-100 dark:text-stone-900'
                : 'text-stone-500 hover:text-stone-900 dark:hover:text-stone-100',
            ]}
          >
            {name}
          </a>
        ))}
      </div>

      <a href={getLocalizedPath('/download', lang)} class="btn-primary hidden text-sm sm:inline-flex">
        {t('hero.cta.download')}
      </a>

      {/* Mobile menu button */}
      <button
        id="mobile-menu-btn"
        class="inline-flex items-center justify-center rounded-lg p-2 text-stone-600 hover:bg-stone-100 md:hidden dark:text-stone-400 dark:hover:bg-stone-800"
        aria-label="Menu"
      >
        <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
      </button>
    </div>
  </div>

  {/* Mobile menu */}
  <div id="mobile-menu" class="hidden border-t border-stone-200 bg-stone-50 md:hidden dark:border-stone-800 dark:bg-stone-950">
    <div class="section-container space-y-1 py-4">
      {navItems.map(({ href, label }) => (
        <a
          href={getLocalizedPath(href, lang)}
          class="block rounded-lg px-3 py-2.5 text-sm text-stone-600 hover:bg-stone-100 hover:text-stone-900 dark:text-stone-400 dark:hover:bg-stone-800 dark:hover:text-stone-50"
        >
          {label}
        </a>
      ))}
    </div>
  </div>
</header>

<script>
  const btn = document.getElementById('mobile-menu-btn');
  const menu = document.getElementById('mobile-menu');
  const themeToggle = document.getElementById('theme-toggle');
  const root = document.documentElement;
  const themeStorageKey = 'exomind-theme';

  const moonIcon = themeToggle?.querySelector('[data-theme-icon="moon"]');
  const sunIcon = themeToggle?.querySelector('[data-theme-icon="sun"]');
  const darkModeLabel = themeToggle?.getAttribute('data-label-dark') ?? 'Switch to dark mode';
  const lightModeLabel = themeToggle?.getAttribute('data-label-light') ?? 'Switch to light mode';

  const getCurrentTheme = () => (root.classList.contains('dark') ? 'dark' : 'light');

  const updateThemeButton = (theme) => {
    const isDark = theme === 'dark';
    themeToggle?.setAttribute('aria-pressed', isDark ? 'true' : 'false');
    themeToggle?.setAttribute('aria-label', isDark ? lightModeLabel : darkModeLabel);
    moonIcon?.classList.toggle('hidden', isDark);
    sunIcon?.classList.toggle('hidden', !isDark);
  };

  const applyTheme = (theme, persistPreference = false) => {
    const isDark = theme === 'dark';
    root.classList.toggle('dark', isDark);
    root.dataset.theme = theme;
    root.style.colorScheme = theme;

    if (persistPreference) {
      try {
        window.localStorage.setItem(themeStorageKey, theme);
      } catch {
        // Ignore storage failures in private browsing modes.
      }
    }

    updateThemeButton(theme);
  };

  btn?.addEventListener('click', () => {
    menu?.classList.toggle('hidden');
  });

  updateThemeButton(getCurrentTheme());

  themeToggle?.addEventListener('click', () => {
    const nextTheme = getCurrentTheme() === 'dark' ? 'light' : 'dark';
    applyTheme(nextTheme, true);
  });

  const mediaQuery = window.matchMedia('(prefers-color-scheme: dark)');
  mediaQuery.addEventListener?.('change', (event) => {
    let storedTheme = null;
    try {
      storedTheme = window.localStorage.getItem(themeStorageKey);
    } catch {
      storedTheme = null;
    }
    if (storedTheme === 'dark' || storedTheme === 'light') {
      return;
    }
    applyTheme(event.matches ? 'dark' : 'light', false);
  });
</script>
