              "textGrowth": "fixed-width",
              "width": "fill_container",
              "content": "Tauri 原生插件是编译时链接的 Rust crate，不支持运行时动态加载。\n要做市场级插件系统，需要运行时方案：",
              "lineHeight": 1.6,
              "fontFamily": "Inter",
              "fontSize": 13,
              "fontWeight": "normal"
            },
            {
              "type": "frame",
              "id": "XvM8K",
              "name": "sec1c",
              "width": "fill_container",
              "fill": "#FEF2EE",
              "cornerRadius": 12,
