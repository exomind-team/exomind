---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getLocalizedPath } from '../../i18n';

export const prerender = true;
const target = getLocalizedPath('/changelog', 'en');
---

<BaseLayout title="Version Log">
  <section class="relative overflow-hidden pt-32 pb-24">
    <div class="section-container relative z-10">
      <div class="mx-auto max-w-2xl text-center">
        <h1 class="heading-display text-4xl leading-tight text-stone-900 sm:text-5xl dark:text-stone-50">
          Downloads moved into the version log
        </h1>
        <p class="mt-4 text-lg leading-relaxed text-stone-500">
          ExoMind now keeps downloads, release channels, and version history in one place.
        </p>
        <div class="mt-8">
          <a href={target} class="btn-primary px-8 py-3 text-base">Open Version Log</a>
        </div>
      </div>
    </div>
  </section>

  <script is:inline define:vars={{ target }}>
    window.location.replace(target);
  </script>
</BaseLayout>
