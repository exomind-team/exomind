---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { useTranslations } from '../../i18n';

const t = useTranslations('en');
---

<BaseLayout title="Home">
  <section class="relative overflow-hidden pt-32 pb-24">
    <div class="section-container relative z-10">
      <div class="mx-auto max-w-4xl text-center">
        <div class="mb-6 inline-flex items-center gap-2 rounded-full border border-stone-200 bg-white/80 px-4 py-1.5 text-sm text-stone-600 backdrop-blur dark:border-stone-800 dark:bg-stone-900/80 dark:text-stone-400">
          <span class="inline-block h-1.5 w-1.5 rounded-full bg-brand animate-pulse"></span>
          Local First · Event Driven · Cognitive Sovereignty
        </div>
        <h1 class="heading-display text-5xl leading-tight text-stone-900 sm:text-6xl lg:text-7xl dark:text-stone-50">
          {t('hero.title')}
        </h1>
        <p class="mx-auto mt-6 max-w-3xl text-lg leading-relaxed text-stone-500 sm:text-xl">
          {t('hero.subtitle')}
        </p>
        <p class="mx-auto mt-4 max-w-2xl text-sm leading-relaxed text-stone-400 sm:text-base">
          ExoMind is for people who do not want to outsource memory, tasks, agents, and workflows to platforms. The goal is to bring cognitive sovereignty back to the user.
        </p>
        <div class="mt-10 flex flex-col items-center justify-center gap-4 sm:flex-row">
          <a href="/en/download" class="btn-primary px-8 py-3.5 text-base">
            {t('hero.cta.download')}
          </a>
          <a href="/en/docs" class="btn-secondary px-8 py-3.5 text-base">
            {t('hero.cta.learn')}
          </a>
        </div>
      </div>
    </div>
    <div class="absolute inset-0 -z-10">
      <div class="absolute left-1/2 top-0 h-[600px] w-[600px] -translate-x-1/2 -translate-y-1/2 rounded-full bg-brand/5 blur-3xl"></div>
    </div>
  </section>

  <section class="bg-stone-100/50 py-24 dark:bg-stone-900/50">
    <div class="section-container">
      <div class="mx-auto mb-16 max-w-3xl text-center">
        <h2 class="heading-display text-3xl text-stone-900 sm:text-4xl dark:text-stone-50">
          {t('features.title')}
        </h2>
        <p class="mt-4 text-stone-500">{t('features.subtitle')}</p>
      </div>
      <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        <div class="card hover:-translate-y-1 transition-all duration-300">
          <div class="mb-4 flex h-12 w-12 items-center justify-center rounded-xl bg-brand-50 dark:bg-brand-900/30">
            <svg class="h-6 w-6 text-brand" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"/><path d="M22 3h-6a4 4 0 0 1-4 4v14a3 3 0 0 0 3-3h7z"/>
            </svg>
          </div>
          <h3 class="text-lg font-semibold text-stone-900 dark:text-stone-50">{t('features.eventlog.title')}</h3>
          <p class="mt-2 text-sm leading-relaxed text-stone-500">{t('features.eventlog.desc')}</p>
        </div>
        <div class="card hover:-translate-y-1 transition-all duration-300">
          <div class="mb-4 flex h-12 w-12 items-center justify-center rounded-xl bg-brand-50 dark:bg-brand-900/30">
            <svg class="h-6 w-6 text-brand" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <line x1="10" x2="14" y1="2" y2="2"/><line x1="12" x2="15" y1="14" y2="11"/><circle cx="12" cy="14" r="8"/>
            </svg>
          </div>
          <h3 class="text-lg font-semibold text-stone-900 dark:text-stone-50">{t('features.timeblock.title')}</h3>
          <p class="mt-2 text-sm leading-relaxed text-stone-500">{t('features.timeblock.desc')}</p>
        </div>
        <div class="card hover:-translate-y-1 transition-all duration-300">
          <div class="mb-4 flex h-12 w-12 items-center justify-center rounded-xl bg-brand-50 dark:bg-brand-900/30">
            <svg class="h-6 w-6 text-brand" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M12 8V4H8"/><rect width="16" height="12" x="4" y="8" rx="2"/><path d="M2 14h2"/><path d="M20 14h2"/><path d="M15 13v2"/><path d="M9 13v2"/>
            </svg>
          </div>
          <h3 class="text-lg font-semibold text-stone-900 dark:text-stone-50">{t('features.agents.title')}</h3>
          <p class="mt-2 text-sm leading-relaxed text-stone-500">{t('features.agents.desc')}</p>
        </div>
        <div class="card hover:-translate-y-1 transition-all duration-300">
          <div class="mb-4 flex h-12 w-12 items-center justify-center rounded-xl bg-brand-50 dark:bg-brand-900/30">
            <svg class="h-6 w-6 text-brand" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z"/>
            </svg>
          </div>
          <h3 class="text-lg font-semibold text-stone-900 dark:text-stone-50">{t('features.privacy.title')}</h3>
          <p class="mt-2 text-sm leading-relaxed text-stone-500">{t('features.privacy.desc')}</p>
        </div>
        <div class="card hover:-translate-y-1 transition-all duration-300">
          <div class="mb-4 flex h-12 w-12 items-center justify-center rounded-xl bg-brand-50 dark:bg-brand-900/30">
            <svg class="h-6 w-6 text-brand" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="m3 17 2 2 4-4"/><path d="m3 7 2 2 4-4"/><path d="M13 6h8"/><path d="M13 12h8"/><path d="M13 18h8"/>
            </svg>
          </div>
          <h3 class="text-lg font-semibold text-stone-900 dark:text-stone-50">{t('features.tasks.title')}</h3>
          <p class="mt-2 text-sm leading-relaxed text-stone-500">{t('features.tasks.desc')}</p>
        </div>
        <div class="card hover:-translate-y-1 transition-all duration-300">
          <div class="mb-4 flex h-12 w-12 items-center justify-center rounded-xl bg-brand-50 dark:bg-brand-900/30">
            <svg class="h-6 w-6 text-brand" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <rect width="20" height="14" x="2" y="3" rx="2"/><line x1="8" x2="16" y1="21" y2="21"/><line x1="12" x2="12" y1="17" y2="21"/>
            </svg>
          </div>
          <h3 class="text-lg font-semibold text-stone-900 dark:text-stone-50">{t('features.crossplatform.title')}</h3>
          <p class="mt-2 text-sm leading-relaxed text-stone-500">{t('features.crossplatform.desc')}</p>
        </div>
      </div>
      <div class="mt-12 text-center">
        <a href="/en/features" class="inline-flex items-center gap-2 font-medium text-brand hover:underline">
          View all features
          <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
        </a>
      </div>
    </div>
  </section>

  <section class="py-24">
    <div class="section-container">
      <div class="mx-auto mb-16 max-w-2xl text-center">
        <h2 class="heading-display text-3xl text-stone-900 sm:text-4xl dark:text-stone-50">Three steps to regain cognitive sovereignty</h2>
      </div>
      <div class="relative mx-auto max-w-4xl">
        <div class="absolute left-[calc(16.67%-1px)] right-[calc(16.67%-1px)] top-8 hidden h-0.5 border-t-2 border-dashed border-stone-200 dark:border-stone-700 sm:block"></div>
        <div class="grid gap-12 sm:grid-cols-3 sm:gap-8">
          <div class="text-center">
            <div class="relative mx-auto mb-6 flex h-16 w-16 items-center justify-center rounded-full bg-brand text-xl font-bold text-white">1</div>
            <h3 class="text-lg font-semibold text-stone-900 dark:text-stone-50">Capture Facts</h3>
            <p class="mt-2 text-sm text-stone-500">Turn journals, tasks, actions, and signals into a traceable event stream so your actual history stays with you.</p>
          </div>
          <div class="text-center">
            <div class="relative mx-auto mb-6 flex h-16 w-16 items-center justify-center rounded-full bg-brand text-xl font-bold text-white">2</div>
            <h3 class="text-lg font-semibold text-stone-900 dark:text-stone-50">Dispatch Agents</h3>
            <p class="mt-2 text-sm text-stone-500">Let agents work inside your own workspace and devices instead of being trapped inside a chat box.</p>
          </div>
          <div class="text-center">
            <div class="relative mx-auto mb-6 flex h-16 w-16 items-center justify-center rounded-full bg-brand text-xl font-bold text-white">3</div>
            <h3 class="text-lg font-semibold text-stone-900 dark:text-stone-50">Extend the Body</h3>
            <p class="mt-2 text-sm text-stone-500">Gradually connect desktop, phone, and servers into one evolving exomind body where capabilities move across devices.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="bg-stone-100/50 py-24 dark:bg-stone-900/50">
    <div class="section-container">
      <div class="mx-auto mb-16 max-w-2xl text-center">
        <h2 class="heading-display text-3xl text-stone-900 sm:text-4xl dark:text-stone-50">Keep data, agents, and workflows in your own hands</h2>
        <p class="mt-4 text-stone-500">This is not “a nicer SaaS.” It is an attempt to reclaim the infrastructure of memory, action, and coordination from the platforms that rent it back to you.</p>
      </div>
      <div class="grid gap-6 sm:grid-cols-3">
        <div class="rounded-2xl border border-stone-200 bg-white p-8 text-center dark:border-stone-800 dark:bg-stone-900">
          <div class="text-3xl font-bold text-brand">100%</div>
          <div class="mt-2 text-sm text-stone-500">Local First</div>
        </div>
        <div class="rounded-2xl border border-stone-200 bg-white p-8 text-center dark:border-stone-800 dark:bg-stone-900">
          <div class="text-3xl font-bold text-brand">Zero</div>
          <div class="mt-2 text-sm text-stone-500">Platform Rent</div>
        </div>
        <div class="rounded-2xl border border-stone-200 bg-white p-8 text-center dark:border-stone-800 dark:bg-stone-900">
          <div class="text-3xl font-bold text-brand">Public</div>
          <div class="mt-2 text-sm text-stone-500">Governance & Updates</div>
        </div>
      </div>
    </div>
  </section>

  <section class="py-24">
    <div class="section-container">
      <div class="mx-auto max-w-2xl text-center">
        <h2 class="heading-display text-3xl text-stone-900 sm:text-4xl dark:text-stone-50">Read the public docs first, then download real builds</h2>
        <p class="mt-4 text-stone-500">This website now promotes only platforms that are actually available. Nothing unready is presented as a finished public release.</p>
        <div class="mt-10 flex flex-col items-center justify-center gap-4 sm:flex-row">
          <a href="/en/download" class="btn-primary px-8 py-3.5 text-base">View Downloads</a>
          <a href="/en/docs" class="btn-secondary px-8 py-3.5 text-base">Read Public Docs</a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
