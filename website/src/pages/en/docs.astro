---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { useTranslations } from '../../i18n';

const t = useTranslations('en');

const guideCards = [
  {
    title: 'Project Overview',
    desc: 'ExoMind is a local-first, event-driven personal AI exomind system. The point is not to consume AI through platforms, but to rebuild memory, agents, and workflows on devices you actually control.',
    points: ['Local-first storage and sync', 'Event logs as the base layer of long-term memory', 'Agents that run inside your workspace'],
  },
  {
    title: 'Governance & Ownership',
    desc: 'This governance PR clarifies how decisions are made, how shared resources are handled, and what belongs to the individual versus the collective.',
    points: ['Cognitive sovereignty belongs to the individual', 'Collective resources are coordinated by contribution', 'Roles and governance direction are made public'],
  },
  {
    title: 'How to Participate',
    desc: 'For now, the public path is simple: understand the thesis, track versions, and follow the release status. The full doc site will keep growing from here.',
    points: ['Start with the thesis and roadmap', 'Check which builds are actually available', 'Join gradually through the governance path'],
  },
];

const publicEntries = [
  {
    title: 'Downloads',
    href: '/en/download',
    desc: 'See which platforms are truly downloadable right now and which are still rolling out.',
  },
  {
    title: 'Changelog',
    href: '/en/changelog',
    desc: 'A public record of recent versions, release capabilities, and outward-facing milestones.',
  },
  {
    title: 'About ExoMind',
    href: '/en/about',
    desc: 'Understand the project thesis, naming, and why this system exists in the first place.',
  },
];
---

<BaseLayout title={t('docs.title')}>
  <section class="relative overflow-hidden pt-32 pb-16">
    <div class="section-container relative z-10">
      <div class="mx-auto max-w-3xl text-center">
        <h1 class="heading-display text-4xl leading-tight text-stone-900 sm:text-5xl lg:text-6xl dark:text-stone-50">
          {t('docs.title')}
        </h1>
        <p class="mt-4 text-lg leading-relaxed text-stone-500">
          {t('docs.subtitle')}
        </p>
      </div>
    </div>
    <div class="absolute inset-0 -z-10">
      <div class="absolute left-1/2 top-0 h-[500px] w-[500px] -translate-x-1/2 -translate-y-1/2 rounded-full bg-brand/5 blur-3xl"></div>
    </div>
  </section>

  <section class="pb-16">
    <div class="section-container">
      <div class="grid gap-6 lg:grid-cols-3">
        {guideCards.map((card) => (
          <article class="card p-8">
            <h2 class="text-xl font-semibold text-stone-900 dark:text-stone-50">{card.title}</h2>
            <p class="mt-3 text-sm leading-relaxed text-stone-500">{card.desc}</p>
            <ul class="mt-5 space-y-2 text-sm text-stone-600 dark:text-stone-300">
              {card.points.map((point) => (
                <li class="flex items-start gap-2">
                  <span class="mt-1 inline-block h-1.5 w-1.5 rounded-full bg-brand"></span>
                  <span>{point}</span>
                </li>
              ))}
            </ul>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="pb-16">
    <div class="section-container">
      <div class="card p-8 md:p-10">
        <p class="text-sm font-medium uppercase tracking-[0.22em] text-brand">Public Entry</p>
        <h2 class="heading-display mt-3 text-3xl leading-tight text-stone-900 sm:text-4xl dark:text-stone-50">
          Start with the information that is already public
        </h2>
        <p class="mt-4 max-w-3xl text-base leading-relaxed text-stone-500">
          This is no longer a “coming soon” placeholder. It is the public entry layer for the current governance PR, so outsiders can understand the project, track release status, and find the real download surface.
        </p>

        <div class="mt-8 grid gap-4 md:grid-cols-3">
          {publicEntries.map((entry) => (
            <a href={entry.href} class="rounded-2xl border border-stone-200 bg-stone-50 p-5 transition-colors hover:border-brand/40 hover:bg-white dark:border-stone-800 dark:bg-stone-950 dark:hover:bg-stone-900">
              <p class="text-base font-semibold text-stone-900 dark:text-stone-50">{entry.title}</p>
              <p class="mt-2 text-sm leading-relaxed text-stone-500">{entry.desc}</p>
            </a>
          ))}
        </div>
      </div>
    </div>
  </section>

  <section class="pb-24">
    <div class="section-container">
      <div class="mx-auto max-w-3xl rounded-2xl border border-dashed border-stone-300 px-6 py-8 text-center text-sm leading-relaxed text-stone-500 dark:border-stone-700">
        The full doc site will keep expanding, but this page already provides the public essentials: the project thesis, governance framing, and the release entry points that outsiders can actually use.
      </div>
    </div>
  </section>
</BaseLayout>
