{
  "name": "exomind-monorepo",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "bun@1.3.8",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "clean": "turbo run clean",
    "test": "turbo run test",
    "dev:ui": "turbo run dev --filter=@exomind/ui",
    "dev:tauri": "cd apps/tauri-app && bun run tauri dev"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.18",
    "@tailwindcss/typography": "^0.5.19",
    "@types/react": "^18.3.1",
    "@types/react-dom": "^18.3.1",
    "autoprefixer": "^10.4.24",
    "clsx": "^2.1.1",
    "tailwind-merge": "^3.4.0",
    "tailwindcss": "^4.1.18",
    "turbo": "^2.3.0",
    "typescript": "~5.6.2"
  }
}
