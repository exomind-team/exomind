/**
 * ACP (Agent Communication Protocol) SDK 示例脚本
 *
 * 使用官方 acp-sdk 包实现 Agent 通信
 * 位置：agents/ts/test/acp_example.test.ts
 *
 * NPM 包：acp-sdk
 * 官方文档：https://github.com/i-am-bee/acp
 *
 * 支持：
 * - 同步/异步 Agent 执行
 * - 流式交互
 * - 有状态/无状态模式
 * - Agent 发现
 * - 长时任务
 */

import { Client } from 'acp-sdk';

// ============================================
// 1. 配置
// ============================================

interface AcpConfig {
  /** ACP 服务器地址 */
  baseUrl: string;
  /** Agent 名称 */
  agentName: string;
  /** API 密钥（可选） */
  apiKey?: string;
  /** 超时时间（毫秒） */
  timeout?: number;
}

// 默认配置（需要根据实际服务器修改）
const DEFAULT_CONFIG: AcpConfig = {
  baseUrl: process.env.ACP_SERVER_URL || 'http://localhost:8000',
  agentName: 'rss_infosource_collector',
  apiKey: process.env.ACP_API_KEY,
  timeout: 30000,
};

// ============================================
// 2. RSS Agent ACP 客户端封装
// ============================================

/**
 * RSS Agent ACP 客户端
 *
 * 基于官方 acp-sdk 封装，提供 RSS 场景专用接口
 */
export class RssAgentAcpClient {
  private client: Client;
  private config: AcpConfig;

  constructor(config?: Partial<AcpConfig>) {
    this.config = { ...DEFAULT_CONFIG, ...config };
    this.client = new Client({
      baseUrl: this.config.baseUrl,
      timeout: this.config.timeout,
    });
  }

  /**
   * 创建同步运行实例
   */
  private async createRun(): Promise<{ run: unknown; output: unknown[] }> {
    const run = await this.client.runSync(this.config.agentName, '');
    const output: unknown[] = [];
    return { run, output };
  }

  /**
   * 发送 RSS 更新通知
   *
   * @param source RSS 源名称
   * @param articleCount 文章数量
   * @returns 执行结果
   */
  async notifyRssUpdate(source: string, articleCount: number): Promise<unknown> {
    console.log(`[ACP] 通知 RSS 更新: ${source}, ${articleCount} 篇新文章`);

    const prompt = `
      [RSS更新通知]
      来源: ${source}
      新文章数: ${articleCount}
      时间: ${new Date().toISOString()}

      请记录这次 RSS 更新，并准备处理新文章。
    `;

    const run = await this.client.runSync(this.config.agentName, prompt);
    return run;
  }

  /**
   * 通知知识卡片创建
   *
   * @param title 卡片标题
   * @param category 分类
   * @param sources 来源列表
   */
  async notifyKnowledgeCardCreated(
    title: string,
    category: string,
    sources: Array<{ id: string; url: string }>
  ): Promise<unknown> {
    console.log(`[ACP] 通知知识卡片创建: ${title}`);

    const prompt = `
      [知识卡片创建通知]
      标题: ${title}
      分类: ${category}
      来源数量: ${sources.length}

      来源详情:
      ${sources.map((s, i) => `${i + 1}. [${s.id}] ${s.url}`).join('\n')}

      请更新知识库索引。
    `;

    const run = await this.client.runSync(this.config.agentName, prompt);
    return run;
  }

  /**
   * 执行健康检查
   */
  async healthCheck(): Promise<unknown> {
    console.log('[ACP] 执行健康检查');

    const prompt = `
      [系统指令]
      请执行健康检查，返回以下信息：
      1. 当前认知密度
      2. 缓存效率
      3. 待处理任务数
      4. 长期记忆状态
    `;

    const run = await this.client.runSync(this.config.agentName, prompt);
    return run;
  }

  /**
   * 异步运行（适用于长时间任务）
   */
  async runAsync(prompt: string): Promise<{ runId: string }> {
    console.log(`[ACP] 启动异步任务`);

    const runId = await this.client.runAsync(this.config.agentName, prompt);
    console.log(`[ACP] 任务 ID: ${runId}`);

    return { runId };
  }

  /**
   * 异步任务状态查询
   */
  async getRunStatus(runId: string): Promise<unknown> {
    const status = await this.client.getRunStatus(runId);
    return status;
  }

  /**
   * 列出可用 Agent
   */
  async listAgents(): Promise<unknown> {
    console.log('[ACP] 列出可用 Agent');
    const agents = await this.client.listAgents();
    return agents;
  }

  /**
   * 获取 Agent 能力描述
   */
  async getAgentCapabilities(agentName: string): Promise<unknown> {
    const capabilities = await this.client.getAgentCapabilities(agentName);
    return capabilities;
  }

  /**
   * 执行流式输出
   */
  async *runStream(prompt: string): AsyncGenerator<string> {
    console.log(`[ACP] 启动流式任务`);

    const stream = await this.client.runStream(this.config.agentName, prompt);
    for await (const chunk of stream) {
      yield chunk;
    }
  }

  /**
   * 验证连接状态
   */
  async ping(): Promise<boolean> {
    try {
      await this.client.runSync(this.config.agentName, 'ping');
      return true;
    } catch {
      return false;
    }
  }
}

// ============================================
// 3. 使用示例
// ============================================

/**
 * 运行示例
 */
export async function runExample(): Promise<void> {
  console.log('='.repeat(60));
  console.log('ACP (Agent Communication Protocol) SDK 示例');
  console.log('='.repeat(60));
  console.log();
  console.log(`服务器: ${DEFAULT_CONFIG.baseUrl}`);
  console.log(`Agent: ${DEFAULT_CONFIG.agentName}`);
  console.log();

  // 创建客户端
  const rssClient = new RssAgentAcpClient();

  // 验证连接
  console.log('[示例] 验证连接...');
  const connected = await rssClient.ping();
  console.log(`  连接状态: ${connected ? '✓ 在线' : '✗ 离线或超时'}`);
  console.log();

  if (!connected) {
    console.log('[示例] 连接失败，请确保 ACP 服务器已启动');
    console.log('  启动命令: 参考 acp-server 文档');
    console.log();
    return;
  }

  // 示例 1: 通知 RSS 更新
  console.log('[示例 1] 通知 RSS 更新');
  const updateResult = await rssClient.notifyRssUpdate('wechat_jiqizhixin', 5);
  console.log(`  结果: ${JSON.stringify(updateResult, null, 2)}`);
  console.log();

  // 示例 2: 通知知识卡片创建
  console.log('[示例 2] 通知知识卡片创建');
  const cardResult = await rssClient.notifyKnowledgeCardCreated(
    'Claude MCP 深度解析',
    'tech/ai',
    [
      { id: 'wechat_jiqizhixin', url: 'https://example.com/1' },
      { id: 'sspai', url: 'https://example.com/2' },
    ]
  );
  console.log(`  结果: ${JSON.stringify(cardResult, null, 2)}`);
  console.log();

  // 示例 3: 健康检查
  console.log('[示例 3] 健康检查');
  const healthResult = await rssClient.healthCheck();
  console.log(`  结果: ${JSON.stringify(healthResult, null, 2)}`);
  console.log();

  // 示例 4: 列出可用 Agent
  console.log('[示例 4] 列出可用 Agent');
  const agents = await rssClient.listAgents();
  console.log(`  结果: ${JSON.stringify(agents, null, 2)}`);
  console.log();

  // 示例 5: 流式输出
  console.log('[示例 5] 流式输出');
  console.log('  输出: ');
  const stream = rssClient.runStream('请用3句话介绍 RSS 信息收集 Agent 的工作原理');
  for await (const chunk of stream) {
    process.stdout.write(`    ${chunk}`);
  }
  console.log('\n');

  console.log('[示例] 所有示例完成！');
}

// ============================================
// 4. 单元测试
// ============================================

/**
 * 配置测试
 */
export function testConfig(): void {
  console.log('[测试] 配置测试');
  console.log('-'.repeat(40));

  console.log(`  ✓ baseUrl: ${DEFAULT_CONFIG.baseUrl}`);
  console.log(`  ✓ agentName: ${DEFAULT_CONFIG.agentName}`);
  console.log(`  ✓ timeout: ${DEFAULT_CONFIG.timeout}ms`);
  console.log(`  ✓ apiKey: ${DEFAULT_CONFIG.apiKey ? '已设置' : '未设置'}`);

  console.log();
  console.log('[测试] 配置测试通过！');
}

/**
 * 客户端初始化测试
 */
export function testClientInit(): void {
  console.log('[测试] 客户端初始化测试');
  console.log('-'.repeat(40));

  try {
    const client = new RssAgentAcpClient();
    console.log(`  ✓ 客户端创建成功`);
    console.log(`  ✓ 服务器地址: ${client['config'].baseUrl}`);
    console.log(`  ✓ Agent 名称: ${client['config'].agentName}`);
    console.log();
    console.log('[测试] 客户端初始化测试通过！');
  } catch (error) {
    console.log(`  ✗ 客户端创建失败: ${error}`);
  }
}

// ============================================
// 5. 主入口
// ============================================

async function main(): Promise<void> {
  const args = process.argv.slice(2);
  const testMode = args.includes('--test');

  if (testMode) {
    // 运行测试
    testConfig();
    console.log();
    testClientInit();
  } else {
    // 运行示例
    await runExample();
  }
}

// 运行
main().catch(console.error);
