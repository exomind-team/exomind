              "padding": 16,
              "children": [
                {
                  "type": "text",
                  "id": "ks2Yo",
                  "name": "s1c1",
                  "fill": "#44403C",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "• WASM 插件 — wasmtime/wasmer 沙箱执行，安全、跨平台、可热加载（Zed 方案）",
                  "lineHeight": 1.5,
                  "fontFamily": "Inter",
                  "fontSize": 12,
                  "fontWeight": "normal"
                },
                {
                  "type": "text",
                  "id": "Fq6Fa",
                  "name": "s1c2",
                  "fill": "#44403C",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "• 脚本插件 — Lua (mlua) 或 JS (deno_core) 嵌入式引擎，灵活易开发",
                  "lineHeight": 1.5,
                  "fontFamily": "Inter",
                  "fontSize": 12,
                  "fontWeight": "normal"
                },
                {
                  "type": "text",
                  "id": "ff9GU",
                  "name": "s1c3",
                  "fill": "#44403C",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "• 进程插件 — 独立进程 + IPC/stdio，类似 MCP 协议，最松耦合",
                  "lineHeight": 1.5,
                  "fontFamily": "Inter",
                  "fontSize": 12,
                  "fontWeight": "normal"
                },
