---
import BaseLayout from '../layouts/BaseLayout.astro';
import { useTranslations } from '../i18n';

export const prerender = true;

const t = useTranslations('zh');

const platforms = [
  { name: 'Windows', icon: 'windows', req: t('download.sysreq.windows'), assetKey: 'windows-x64-setup' },
  { name: 'Android', icon: 'android', req: t('download.sysreq.android'), assetKey: 'android-arm64' },
  { name: 'macOS', icon: 'macos', req: t('download.sysreq.macos'), assetKey: 'macos-aarch64' },
  { name: 'Linux', icon: 'linux', req: t('download.sysreq.linux'), assetKey: 'linux-x64-appimage' },
];
---

<BaseLayout title="下载">
  <section class="relative overflow-hidden pt-32 pb-16">
    <div class="section-container relative z-10">
      <div class="mx-auto max-w-3xl text-center">
        <h1 class="heading-display text-5xl leading-tight text-stone-900 sm:text-6xl dark:text-stone-50">
          {t('download.title')}
        </h1>
        <p class="mt-6 text-lg leading-relaxed text-stone-500 sm:text-xl">
          {t('download.subtitle')}
        </p>
      </div>
    </div>
    <div class="absolute inset-0 -z-10">
      <div class="absolute left-1/2 top-0 h-[600px] w-[600px] -translate-x-1/2 -translate-y-1/2 rounded-full bg-brand/5 blur-3xl"></div>
    </div>
  </section>

  <section class="pb-8">
    <div class="section-container">
      <div class="mx-auto flex max-w-xs items-center justify-center">
        <div id="channel-toggle" class="inline-flex rounded-xl border border-stone-200 bg-white p-1 dark:border-stone-800 dark:bg-stone-900">
          <button data-channel="release" class="channel-btn active rounded-lg px-5 py-2 text-sm font-medium transition-all">稳定版</button>
          <button data-channel="preview" class="channel-btn rounded-lg px-5 py-2 text-sm font-medium transition-all">预览版</button>
        </div>
      </div>
    </div>
  </section>

  <section class="pb-20">
    <div class="section-container">
      <div class="mx-auto grid max-w-3xl gap-6 sm:grid-cols-2">
        {platforms.map((platform) => (
          <div class="card flex flex-col items-center p-8 text-center" data-platform={platform.assetKey}>
            <div class="mb-4 flex h-16 w-16 items-center justify-center rounded-2xl bg-stone-100 text-stone-700 dark:bg-stone-800 dark:text-stone-300">
              {platform.icon === 'windows' && (
                <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 30 30" fill="currentColor">
                  <path d="M0 4.5l12.6-1.7v12.1H0zm13.8-1.9L30 0v14.9H13.8zM0 16.8h12.6v12.1L0 27.2zm13.8-.3H30V30l-16.2-2.5z"/>
                </svg>
              )}
              {platform.icon === 'android' && (
                <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="currentColor">
                  <path d="M6 18c0 .55.45 1 1 1h1v3.5c0 .83.67 1.5 1.5 1.5s1.5-.67 1.5-1.5V19h2v3.5c0 .83.67 1.5 1.5 1.5s1.5-.67 1.5-1.5V19h1c.55 0 1-.45 1-1V8H6v10zM3.5 8C2.67 8 2 8.67 2 9.5v7c0 .83.67 1.5 1.5 1.5S5 17.33 5 16.5v-7C5 8.67 4.33 8 3.5 8zm17 0c-.83 0-1.5.67-1.5 1.5v7c0 .83.67 1.5 1.5 1.5s1.5-.67 1.5-1.5v-7c0-.83-.67-1.5-1.5-1.5zM15.53 2.16l1.3-1.3c.2-.2.2-.51 0-.71-.2-.2-.51-.2-.71 0l-1.48 1.48A5.84 5.84 0 0 0 12 1c-.96 0-1.86.23-2.66.63L7.85.15c-.2-.2-.51-.2-.71 0-.2.2-.2.51 0 .71l1.31 1.31A5.983 5.983 0 0 0 6 7h12c0-1.98-.96-3.73-2.47-4.84zM10 5H9V4h1v1zm5 0h-1V4h1v1z"/>
                </svg>
              )}
              {platform.icon === 'macos' && (
                <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                  <rect width="20" height="14" x="2" y="3" rx="2"/>
                  <line x1="8" x2="16" y1="21" y2="21"/>
                  <line x1="12" x2="12" y1="17" y2="21"/>
                </svg>
              )}
              {platform.icon === 'linux' && (
                <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                  <polyline points="4 17 10 11 4 5"/>
                  <line x1="12" x2="20" y1="19" y2="19"/>
                </svg>
              )}
            </div>
            <h3 class="text-lg font-semibold text-stone-900 dark:text-stone-50">{platform.name}</h3>
            <div class="card-content mt-2 w-full">
              <div class="card-skeleton">
                <div class="mx-auto mt-1 h-4 w-20 animate-pulse rounded bg-stone-200 dark:bg-stone-700"></div>
                <div class="mx-auto mt-2 h-3 w-32 animate-pulse rounded bg-stone-100 dark:bg-stone-800"></div>
                <div class="mt-4">
                  <div class="mx-auto h-10 w-28 animate-pulse rounded-xl bg-stone-200 dark:bg-stone-700"></div>
                </div>
              </div>
              <div class="card-loaded hidden">
                <p class="card-version text-sm text-stone-400"></p>
                <p class="card-meta mt-1 text-xs text-stone-400"></p>
                <div class="mt-4">
                  <a class="card-download-btn btn-primary px-6 py-2.5 text-sm" href="#" target="_blank" rel="noopener noreferrer">
                    {t('download.btn')}
                  </a>
                </div>
                <div class="card-extra-links mt-3 flex flex-wrap justify-center gap-3"></div>
              </div>
              <div class="card-error hidden">
                <p class="mt-1 text-sm text-stone-400">暂无可用版本</p>
                <div class="mt-4">
                  <a href="https://github.com/exomind-team/exomind/releases" target="_blank" rel="noopener noreferrer" class="btn-secondary px-5 py-2 text-sm">
                    前往 GitHub
                  </a>
                </div>
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section id="version-list-section" class="hidden pb-20">
    <div class="section-container">
      <div class="mx-auto max-w-3xl">
        <h2 class="heading-display mb-6 text-center text-2xl text-stone-900 sm:text-3xl dark:text-stone-50">历史版本</h2>
        <div id="version-list" class="space-y-3"></div>
        <div id="version-list-expand" class="mt-4 hidden text-center">
          <button class="text-sm font-medium text-brand transition-colors hover:text-brand-600">查看更多版本</button>
        </div>
      </div>
    </div>
  </section>

  <section class="pb-24">
    <div class="section-container">
      <div class="mx-auto max-w-2xl">
        <h2 class="heading-display text-center text-2xl text-stone-900 sm:text-3xl dark:text-stone-50">
          {t('download.sysreq.title')}
        </h2>
        <div class="mt-8 space-y-4">
          {platforms.map((platform) => (
            <div class="flex items-center gap-4 rounded-xl border border-stone-200 bg-white px-6 py-4 dark:border-stone-800 dark:bg-stone-900">
              <span class="w-24 shrink-0 font-medium text-stone-900 dark:text-stone-50">{platform.name}</span>
              <span class="text-sm text-stone-500 dark:text-stone-400">{platform.req}</span>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .channel-btn { color: theme('colors.stone.500'); }
  .channel-btn:hover:not(.active) {
    color: theme('colors.stone.700');
    background-color: theme('colors.stone.50');
  }
  :global(.dark) .channel-btn:hover:not(.active) {
    color: theme('colors.stone.300');
    background-color: theme('colors.stone.800');
  }
  .channel-btn.active {
    background-color: theme('colors.brand.DEFAULT');
    color: white;
    box-shadow: 0 1px 3px rgba(199, 91, 58, 0.3);
  }
</style>

<script>
  import { buildHistoryEntries, resolvePlatformDownload } from '../lib/downloads-data';

  const extraLabels = {
    'windows-x64-installer': 'MSI 安装包',
    'android-x86': 'x86 版本',
    'linux-x64-deb': 'DEB 包',
  };

  function formatSize(bytes) {
    return `${(bytes / (1024 * 1024)).toFixed(1)} MB`;
  }

  function formatDate(isoStr) {
    const date = new Date(isoStr);
    return `${date.getFullYear()}-${String(date.getMonth() + 1).padStart(2, '0')}-${String(date.getDate()).padStart(2, '0')}`;
  }

  let currentChannel = 'release';
  const cache = {};
  const toggleBtns = document.querySelectorAll('.channel-btn');
  const cards = document.querySelectorAll('[data-platform]');
  const versionListSection = document.getElementById('version-list-section');
  const versionList = document.getElementById('version-list');
  const versionListExpand = document.getElementById('version-list-expand');

  toggleBtns.forEach((btn) => {
    btn.addEventListener('click', () => {
      const channel = btn.dataset.channel;
      if (!channel || channel === currentChannel) return;
      currentChannel = channel;
      toggleBtns.forEach((item) => item.classList.remove('active'));
      btn.classList.add('active');
      loadChannel(channel);
    });
  });

  async function loadChannel(channel) {
    cards.forEach((card) => {
      card.querySelector('.card-skeleton')?.classList.remove('hidden');
      card.querySelector('.card-loaded')?.classList.add('hidden');
      card.querySelector('.card-error')?.classList.add('hidden');
    });
    versionListSection?.classList.add('hidden');

    try {
      let data = cache[channel];
      if (!data) {
        const response = await fetch(`/releases/${channel}/versions.json`);
        if (!response.ok) throw new Error(`HTTP ${response.status}`);
        data = await response.json();
        cache[channel] = data;
      }

      renderCards(data.latest);
      if (channel === 'preview' && Array.isArray(data.versions) && data.versions.length > 0) {
        renderVersionList(data);
      }
    } catch (error) {
      console.error('Failed to load release metadata:', error);
      cards.forEach((card) => {
        card.querySelector('.card-skeleton')?.classList.add('hidden');
        card.querySelector('.card-error')?.classList.remove('hidden');
      });
    }
  }

  function renderCards(latest) {
    cards.forEach((card) => {
      const resolved = resolvePlatformDownload(latest, card.dataset.platform);
      card.querySelector('.card-skeleton')?.classList.add('hidden');
      if (!resolved) {
        card.querySelector('.card-loaded')?.classList.add('hidden');
        card.querySelector('.card-error')?.classList.remove('hidden');
        return;
      }

      const versionEl = card.querySelector('.card-version');
      const metaEl = card.querySelector('.card-meta');
      const downloadBtn = card.querySelector('.card-download-btn');
      const extraLinks = card.querySelector('.card-extra-links');

      if (versionEl) versionEl.textContent = `v${resolved.version}`;
      if (metaEl) metaEl.textContent = `${formatDate(resolved.publishedAt)} · ${formatSize(resolved.primary.size)}`;
      if (downloadBtn) downloadBtn.href = resolved.primary.url;
      if (extraLinks) {
        extraLinks.innerHTML = resolved.extras
          .map((extra) => `<a href="${extra.url}" target="_blank" rel="noopener noreferrer" class="text-xs text-brand transition-colors underline underline-offset-2 hover:text-brand-600">${extraLabels[extra.key] ?? extra.label}${extra.size ? ` (${formatSize(extra.size)})` : ''}</a>`)
          .join('');
      }

      card.querySelector('.card-loaded')?.classList.remove('hidden');
      card.querySelector('.card-error')?.classList.add('hidden');
    });
  }

  function renderVersionList(data) {
    const entries = buildHistoryEntries(data);
    const initialCount = 5;
    let showAll = false;

    function render() {
      const items = showAll ? entries : entries.slice(0, initialCount);
      versionList.innerHTML = items
        .map((entry) => `
          <div class="flex items-center justify-between rounded-xl border border-stone-200 bg-white px-6 py-4 dark:border-stone-800 dark:bg-stone-900">
            <div>
              <span class="font-medium text-stone-900 dark:text-stone-50">v${entry.version}</span>
              <span class="ml-3 text-xs text-stone-400">${formatDate(entry.publishedAt)}</span>
            </div>
            <a href="${entry.releaseUrl}" target="_blank" rel="noopener noreferrer" class="text-sm font-medium text-brand transition-colors hover:text-brand-600">查看</a>
          </div>
        `)
        .join('');
    }

    render();
    versionListSection?.classList.remove('hidden');
    if (entries.length > initialCount) {
      versionListExpand?.classList.remove('hidden');
      const button = versionListExpand?.querySelector('button');
      if (button) {
        button.textContent = showAll ? '收起' : '查看更多版本';
        button.onclick = () => {
          showAll = !showAll;
          button.textContent = showAll ? '收起' : '查看更多版本';
          render();
        };
      }
    } else {
      versionListExpand?.classList.add('hidden');
    }
  }

  loadChannel('release');
</script>
