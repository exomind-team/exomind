---
import { Plus } from "lucide-static";
import LucideIcon from "../LucideIcon.astro";
import DocsSidebar from "./DocsSidebar.astro";
import DocsToc from "./DocsToc.astro";
import {
  getDocsPage,
  getDocsPagePath,
  getDocsPrevNext,
  type DocsLocale,
  type DocsPage,
} from "../../lib/docs";

interface Props {
  lang: DocsLocale;
  page: DocsPage;
}

const { lang, page } = Astro.props;
const { prev, next } = getDocsPrevNext(lang, page.slug);
const relatedPages = (page.related ?? [])
  .map((slug) => getDocsPage(lang, slug))
  .filter((item): item is DocsPage => Boolean(item));
const sectionLinks = page.sections.map((section, index) => ({
  id: `${page.slug}-section-${index + 1}`,
  title: section.title,
  index: index + 1,
}));
---

<section class="docs-shell pt-16">
  <div class="docs-shell-grid">
    <DocsSidebar lang={lang} activeSlug={page.slug} />

    <div class="docs-shell-main">
      <div class="docs-shell-content">
        <div class="docs-article-layout">
          <article class="docs-article-main">
            <header class="border-b border-stone-200 pb-10 dark:border-stone-800">
              <p class="text-xs font-semibold uppercase tracking-[0.24em] text-brand/80">
                {page.eyebrow}
              </p>
              <div class="mt-4 flex flex-col gap-4 lg:flex-row lg:items-start lg:justify-between">
                <div class="min-w-0">
                  <h1 class="text-4xl font-semibold tracking-tight text-stone-900 dark:text-stone-50">
                    {page.title}
                  </h1>
                  <p class="mt-4 max-w-4xl text-lg leading-relaxed text-stone-500 dark:text-stone-400">
                    {page.heroLead}
                  </p>
                </div>
                {page.badge && (
                  <div class="inline-flex h-fit rounded-full border border-brand/20 bg-brand/5 px-4 py-2 text-sm font-medium text-brand dark:border-brand/30 dark:bg-brand/10">
                    {page.badge}
                  </div>
                )}
              </div>
            </header>

            <div class="space-y-12 pt-10">
              {page.sections.map((section, index) => (
                <section
                  id={sectionLinks[index].id}
                  class:list={[
                    "scroll-mt-28",
                    index > 0 && "border-t border-stone-200 pt-10 dark:border-stone-800",
                  ]}
                >
                  <h3 class="text-2xl font-semibold tracking-tight text-stone-900 dark:text-stone-50">
                    {section.title}
                  </h3>

                  {section.lead && (
                    <p class="mt-4 max-w-4xl text-base leading-relaxed text-stone-600 dark:text-stone-300">
                      {section.lead}
                    </p>
                  )}

                  {section.paragraphs && (
                    <div class="mt-5 max-w-4xl space-y-4 text-base leading-relaxed text-stone-500 dark:text-stone-400">
                      {section.paragraphs.map((paragraph) => (
                        <p>{paragraph}</p>
                      ))}
                    </div>
                  )}

                  {section.bullets && (
                    <ul class="mt-5 max-w-4xl space-y-3 text-sm leading-relaxed text-stone-500 dark:text-stone-400">
                      {section.bullets.map((bullet) => (
                        <li class="flex gap-3">
                          <span class="mt-1.5 h-2 w-2 shrink-0 rounded-full bg-brand"></span>
                          <span>{bullet}</span>
                        </li>
                      ))}
                    </ul>
                  )}

                  {section.steps && (
                    <div class="mt-6 max-w-5xl space-y-4">
                      {section.steps.map((step) => (
                        <article class="rounded-3xl border border-stone-200 bg-white p-6 dark:border-stone-800 dark:bg-stone-900">
                          <div class="flex flex-col gap-4 sm:flex-row sm:items-start">
                            {step.label && (
                              <div class="flex h-12 w-12 shrink-0 items-center justify-center rounded-2xl bg-brand text-sm font-semibold text-white">
                                {step.label}
                              </div>
                            )}
                            <div class="flex-1">
                              <h4 class="text-xl font-semibold text-stone-900 dark:text-stone-50">
                                {step.title}
                              </h4>
                              {step.description && (
                                <p class="mt-3 max-w-4xl text-sm leading-relaxed text-stone-500 dark:text-stone-400">
                                  {step.description}
                                </p>
                              )}
                              {step.actions && (
                                <ul class="mt-4 max-w-4xl space-y-3 text-sm leading-relaxed text-stone-500 dark:text-stone-400">
                                  {step.actions.map((action) => (
                                    <li class="flex gap-3">
                                      <span class="mt-1.5 h-2 w-2 shrink-0 rounded-full bg-brand"></span>
                                      <span>{action}</span>
                                    </li>
                                  ))}
                                </ul>
                              )}
                              {step.outcome && (
                                <p class="mt-4 max-w-4xl rounded-2xl bg-brand/5 px-4 py-3 text-sm font-medium text-brand dark:bg-brand/10">
                                  {step.outcome}
                                </p>
                              )}
                            </div>
                          </div>
                        </article>
                      ))}
                    </div>
                  )}

                  {section.faqs && (
                    <div class="mt-6 max-w-5xl space-y-4">
                      {section.faqs.map((faq) => (
                        <details class="group rounded-3xl border border-stone-200 bg-white p-6 shadow-sm transition-colors open:border-brand/30 dark:border-stone-800 dark:bg-stone-900 dark:open:border-brand/30">
                          <summary class="flex cursor-pointer list-none items-center justify-between gap-6 text-left text-lg font-semibold text-stone-900 marker:hidden dark:text-stone-50">
                            <span>{faq.question}</span>
                            <LucideIcon
                              icon={Plus}
                              size={18}
                              class="h-[18px] w-[18px] shrink-0 text-brand transition-transform duration-300 group-open:rotate-45"
                            />
                          </summary>
                          <p class="mt-4 max-w-4xl pr-8 text-sm leading-relaxed text-stone-500 dark:text-stone-400">
                            {faq.answer}
                          </p>
                        </details>
                      ))}
                    </div>
                  )}

                  {section.note && (
                    <div class="mt-6 max-w-4xl rounded-2xl border border-brand/20 bg-brand/5 px-5 py-4 text-sm leading-relaxed text-brand dark:border-brand/30 dark:bg-brand/10">
                      {section.note}
                    </div>
                  )}
                </section>
              ))}

              {(prev || next) && (
                <section class="border-t border-stone-200 pt-10 dark:border-stone-800">
                  <div class="grid gap-4 sm:grid-cols-2">
                    {prev ? (
                      <a
                        href={getDocsPagePath(lang, prev.slug)}
                        class="rounded-3xl border border-stone-200 bg-white p-6 transition-colors hover:border-brand/30 dark:border-stone-800 dark:bg-stone-900 dark:hover:border-brand/30"
                      >
                        <p class="text-xs font-semibold uppercase tracking-[0.2em] text-stone-400 dark:text-stone-500">
                          {lang === "zh" ? "上一页" : "Previous"}
                        </p>
                        <h3 class="mt-3 text-lg font-semibold text-stone-900 dark:text-stone-50">
                          {prev.title}
                        </h3>
                        <p class="mt-2 text-sm leading-relaxed text-stone-500 dark:text-stone-400">
                          {prev.summary}
                        </p>
                      </a>
                    ) : (
                      <div></div>
                    )}

                    {next && (
                      <a
                        href={getDocsPagePath(lang, next.slug)}
                        class="rounded-3xl border border-stone-200 bg-white p-6 transition-colors hover:border-brand/30 dark:border-stone-800 dark:bg-stone-900 dark:hover:border-brand/30"
                      >
                        <p class="text-xs font-semibold uppercase tracking-[0.2em] text-stone-400 dark:text-stone-500">
                          {lang === "zh" ? "下一页" : "Next"}
                        </p>
                        <h3 class="mt-3 text-lg font-semibold text-stone-900 dark:text-stone-50">
                          {next.title}
                        </h3>
                        <p class="mt-2 text-sm leading-relaxed text-stone-500 dark:text-stone-400">
                          {next.summary}
                        </p>
                      </a>
                    )}
                  </div>
                </section>
              )}

              {relatedPages.length > 0 && (
                <section class="border-t border-stone-200 pt-10 dark:border-stone-800">
                  <p class="text-xs font-semibold uppercase tracking-[0.24em] text-brand/80">
                    {lang === "zh" ? "Related / 继续读" : "Related / Continue"}
                  </p>
                  <div class="mt-6 grid gap-4 md:grid-cols-2 xl:grid-cols-2 2xl:grid-cols-3">
                    {relatedPages.map((relatedPage) => (
                      <a
                        href={getDocsPagePath(lang, relatedPage.slug)}
                        class="rounded-3xl border border-stone-200 bg-white p-5 transition-colors hover:border-brand/30 dark:border-stone-800 dark:bg-stone-900 dark:hover:border-brand/30"
                      >
                        <h3 class="text-lg font-semibold text-stone-900 dark:text-stone-50">
                          {relatedPage.title}
                        </h3>
                        <p class="mt-3 text-sm leading-relaxed text-stone-500 dark:text-stone-400">
                          {relatedPage.summary}
                        </p>
                      </a>
                    ))}
                  </div>
                </section>
              )}
            </div>
          </article>

          <DocsToc lang={lang} items={sectionLinks} />
        </div>
      </div>
    </div>
  </div>
</section>
