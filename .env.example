# ExoMind 环境变量配置示例
# 复制此文件为 .env 并填入实际值

# === MiniMax API ===
# MiniMax API Key (必需)
MINI_MAX_API_KEY=your_api_key_here
MINI_MAX_API_BASE=https://api.minimaxi.com/anthropic
MINI_MAX_MODEL=MiniMax-M2.1

# === Telegram Bot ===
# Telegram Bot Token (必需)
TELEGRAM_BOT_TOKEN=your_bot_token_here

# === Claude Code 代理 ===
# 用于绕过网络限制访问 Claude API
ANTHROPIC_BASE_URL=http://127.0.0.1:15721

# === LLM API（TS Agent 使用） ===
# OpenAI-compatible endpoint for Reviewer / Classifier agents
EXOMIND_LLM_BASE_URL=https://api.openai.com/v1
EXOMIND_LLM_API_KEY=sk-your-key-here
EXOMIND_LLM_MODEL=gpt-4o-mini

# === 代理配置 ===
HTTPS_PROXY=http://127.0.0.1:7890

# === 应用配置 ===
NODE_ENV=development
LOG_LEVEL=info

# === ExoMind 开发端口（多 worktree 推荐）===
# Vite 开发端口
EXOMIND_WEB_PORT=1420
# Vite HMR 端口（建议与 Web 端口区分）
EXOMIND_HMR_PORT=1421
# PouchDB 同步服务端口
EXOMIND_POUCHDB_PORT=6984
# ASR 后端服务端口
EXOMIND_ASR_PORT=1949
# ASR 端点认证令牌（配置后 /api/asr 需要 Bearer token；留空跳过认证）
EXOMIND_ASR_AUTH_TOKEN=
# 前端可选覆盖地址（优先级高于端口）
# 仅在需要固定地址时取消注释；多 worktree 场景建议保持注释，避免覆盖 EXOMIND_*_PORT。
# VITE_SYNC_SERVER_URL=http://localhost:6984
# VITE_ASR_SERVER_URL=http://localhost:1949

# === 调试选项 ===
# DEBUG=*
# VERBOSE=true

# === Playwright (Termux) ===
# 在 Termux 上执行 E2E 时，使用系统 Chromium
# PLAYWRIGHT_TERMUX=1
# PLAYWRIGHT_BROWSERS_PATH=0
# CHROMIUM_PATH=/data/data/com.termux/files/usr/bin/chromium-browser
