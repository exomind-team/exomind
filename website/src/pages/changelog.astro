---
import BaseLayout from '../layouts/BaseLayout.astro';
import { useTranslations } from '../i18n';

const t = useTranslations('zh');

const changelog = [
  {
    version: 'v0.3.6 开发中',
    date: '未正式发布',
    changes: [
      { type: '新功能', text: '任务系统继续演进：TaskNode 状态语义统一、依赖关系与今日时间块联动继续推进' },
      { type: '新功能', text: '提醒系统、网络/Agent Hub 能力与 runtime/mesh 相关功能持续并入开发线' },
      { type: '优化', text: 'Agent 与 LLM 接入正从 Claude CLI 逐步走向 OpenAI 兼容 API 与统一会话抽象' },
      { type: '说明', text: '该版本目前对应开发线内容，仓库中尚无 release/v0.3.6 正式发布 tag' },
    ],
  },
  {
    version: 'v0.3.5',
    date: '2026-03-06（已发布）',
    changes: [
      { type: '新功能', text: 'Agent Hub UI 全量实现（T1-T9），补齐节点、路由、拓扑、历史与详情侧栏等核心视图' },
      { type: '新功能', text: '完成桌面端适配，并继续补齐 history/chat、生命周期控制与 Android 安全快捷键' },
      { type: '修复', text: '修复语音快捷键流程并稳定多轮 ASR 体验' },
      { type: '优化', text: '发布链路修复 Linux/macOS 构建阻塞问题，支撑 v0.3.5 正式发布' },
    ],
  },
  {
    version: 'v0.3.2',
    date: '2026-02-22（已发布）',
    changes: [
      { type: '新功能', text: '命令面板首期落地，并修复命令面板滚动与入口切换体验' },
      { type: '新功能', text: '新版 UI 正式切为默认入口，同时保留回退路径' },
      { type: '新功能', text: '新增 Agent 页面功能开关、Agent/Actor 详情与设备视图相关界面迭代' },
      { type: '优化', text: '构建标签、预发布流程与官网基础能力继续成形，为后续网站与下载页铺路' },
    ],
  },
  {
    version: 'v0.3.1',
    date: '2026-02-15（已发布）',
    changes: [
      { type: '新功能', text: '浅色新 UI 进入完整可用阶段' },
      { type: '新功能', text: '设置页补齐多用户管理界面，并修复专注卡片自适应' },
      { type: '新功能', text: '聊天消息复制能力上线' },
      { type: '优化', text: '新版专注计时卡片交互与结束设置继续完善' },
    ],
  },
];

function tagClasses(type: string) {
  switch (type) {
    case '新功能': return 'bg-brand-50 text-brand-700 dark:bg-brand-900/30 dark:text-brand-300';
    case '修复': return 'bg-blue-50 text-blue-700 dark:bg-blue-900/30 dark:text-blue-300';
    case '优化': return 'bg-green-50 text-green-700 dark:bg-green-900/30 dark:text-green-300';
    case '说明': return 'bg-amber-50 text-amber-700 dark:bg-amber-900/30 dark:text-amber-300';
    default: return 'bg-stone-100 text-stone-600 dark:bg-stone-800 dark:text-stone-400';
  }
}
---

<BaseLayout title={t('changelog.title')}>
  {/* Hero */}
  <section class="relative overflow-hidden pt-32 pb-16">
    <div class="section-container relative z-10">
      <div class="mx-auto max-w-3xl text-center">
        <h1 class="heading-display text-4xl leading-tight text-stone-900 sm:text-5xl lg:text-6xl dark:text-stone-50">
          {t('changelog.title')}
        </h1>
        <p class="mt-4 text-lg leading-relaxed text-stone-500">
          {t('changelog.subtitle')}
        </p>
        <p class="mt-3 text-sm leading-relaxed text-stone-400">
          说明：已发布版本基于仓库中的 `release/*` tag 整理；`v0.3.6` 当前展示的是开发线进展，不等同于正式 release。
        </p>
      </div>
    </div>
    <div class="absolute inset-0 -z-10">
      <div class="absolute left-1/2 top-0 h-[500px] w-[500px] -translate-x-1/2 -translate-y-1/2 rounded-full bg-brand/5 blur-3xl"></div>
    </div>
  </section>

  {/* Timeline */}
  <section class="pb-24">
    <div class="section-container">
      <div class="mx-auto max-w-3xl">
        <div class="relative border-l-2 border-brand/20 pl-8 dark:border-brand/30">
          {changelog.map((release, i) => (
            <div class:list={['relative', i > 0 ? 'mt-12' : '']}>
              {/* Dot on timeline */}
              <div class="absolute -left-[calc(2rem+5px)] top-0 h-3 w-3 rounded-full border-2 border-brand bg-white dark:bg-stone-950"></div>

              {/* Version + Date */}
              <div class="flex flex-wrap items-center gap-3">
                <span class="rounded-full bg-brand px-3 py-1 text-sm font-medium text-white">
                  {release.version}
                </span>
                <span class="text-sm text-stone-400">{release.date}</span>
              </div>

              {/* Changes */}
              <div class="mt-4 space-y-3">
                {release.changes.map((change) => (
                  <div class="card flex items-start gap-3 p-4">
                    <span class:list={['inline-flex shrink-0 rounded-md px-2 py-0.5 text-xs font-medium', tagClasses(change.type)]}>
                      {change.type}
                    </span>
                    <span class="text-sm text-stone-700 dark:text-stone-300">{change.text}</span>
                  </div>
                ))}
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
