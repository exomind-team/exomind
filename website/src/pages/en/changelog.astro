---
import BaseLayout from '../../layouts/BaseLayout.astro';
import DownloadPageContent from '../../components/DownloadPageContent.astro';
import ChangelogTimeline from '../../components/ChangelogTimeline.astro';
import { useTranslations } from '../../i18n';

const t = useTranslations('en');
---

<BaseLayout title={t('changelog.title')}>
  <section class="relative overflow-hidden pb-16 pt-32">
    <div class="section-container relative z-10">
      <div class="mx-auto max-w-3xl text-center">
        <h1 class="heading-display text-4xl leading-tight text-stone-900 sm:text-5xl lg:text-6xl dark:text-stone-50">
          {t('changelog.title')}
        </h1>
        <p class="mt-4 text-lg leading-relaxed text-stone-500">
          {t('changelog.subtitle')}
        </p>
      </div>
    </div>
    <div class="absolute inset-0 -z-10">
      <div class="absolute left-1/2 top-0 h-[500px] w-[500px] -translate-x-1/2 -translate-y-1/2 rounded-full bg-brand/5 blur-3xl"></div>
    </div>
  </section>

  <DownloadPageContent lang="en" showHero={false} />
  <ChangelogTimeline lang="en" />
</BaseLayout>
