---
import BaseLayout from '../layouts/BaseLayout.astro';
import { useTranslations } from '../i18n';

const t = useTranslations('zh');
---

<BaseLayout title={t('docs.title')}>
  {/* Hero */}
  <section class="relative overflow-hidden pt-32 pb-16">
    <div class="section-container relative z-10">
      <div class="mx-auto max-w-3xl text-center">
        <h1 class="heading-display text-4xl leading-tight text-stone-900 sm:text-5xl lg:text-6xl dark:text-stone-50">
          {t('docs.title')}
        </h1>
        <p class="mt-4 text-lg leading-relaxed text-stone-500">
          {t('docs.subtitle')}
        </p>
      </div>
    </div>
    <div class="absolute inset-0 -z-10">
      <div class="absolute left-1/2 top-0 h-[500px] w-[500px] -translate-x-1/2 -translate-y-1/2 rounded-full bg-brand/5 blur-3xl"></div>
    </div>
  </section>

  {/* Coming Soon */}
  <section class="pb-24">
    <div class="section-container">
      <div class="mx-auto max-w-2xl text-center">
        {/* Icon */}
        <div class="mx-auto flex h-24 w-24 items-center justify-center rounded-full bg-brand-50 dark:bg-brand-900/20">
          <svg class="h-12 w-12 text-brand" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 6.042A8.967 8.967 0 0 0 6 3.75c-1.052 0-2.062.18-3 .512v14.25A8.987 8.987 0 0 1 6 18c2.305 0 4.408.867 6 2.292m0-14.25a8.966 8.966 0 0 1 6-2.292c1.052 0 2.062.18 3 .512v14.25A8.987 8.987 0 0 0 18 18a8.967 8.967 0 0 0-6 2.292m0-14.25v14.25" />
          </svg>
        </div>

        {/* Message */}
        <p class="mt-8 text-lg text-stone-500">
          {t('docs.coming_soon')}
        </p>

        {/* GitHub link */}
        <a
          href="https://github.com/exomind-team/exomind"
          target="_blank"
          rel="noopener"
          class="btn-secondary mt-8 inline-flex items-center gap-2"
        >
          <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4" />
            <path d="M9 18c-4.51 2-5-2-7-2" />
          </svg>
          在 GitHub 上查看
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
