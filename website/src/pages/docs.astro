---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getLocalizedPath } from '../i18n';

const downloadPath = getLocalizedPath('/download', 'zh');
const changelogPath = getLocalizedPath('/changelog', 'zh');
const aboutPath = getLocalizedPath('/about', 'zh');

const handbookSections = [
  {
    title: '3 分钟上手',
    summary: '先完成第一条记录、第一次语音输入，以及第一次时间块。',
    status: '现在可读',
    href: '#quick-start',
    available: true,
  },
  {
    title: '常见问题 / 排障',
    summary: '遇到配对、麦克风权限、网络和兼容模式问题时，从这里开始。',
    status: '现在可读',
    href: '#faq',
    available: true,
  },
  {
    title: '核心概念',
    summary: '解释事件日志、时间块、本地优先和为什么 ExoMind 不从空白开始。',
    status: '即将上线',
    href: '#overview',
    available: false,
  },
  {
    title: '场景教程',
    summary: '按真实任务组织：记录灵感、周回顾、跨设备接续、长期目标推进。',
    status: '即将上线',
    href: '#overview',
    available: false,
  },
  {
    title: '进阶',
    summary: '面向需要外部 RT、兼容模式、导出与更深设置的用户。',
    status: '即将上线',
    href: '#overview',
    available: false,
  },
] as const;

const quickStartSteps = [
  {
    step: '01',
    title: '先写下第一条事件',
    lead: '不要先想分类，也不要先整理结构。把你此刻在做什么写进去就够了。',
    actions: [
      '打开 ExoMind 后，先在事件输入框里写一句你现在正在做的事。',
      '如果你懒得组织语言，写碎片也可以，例如“在整理今天的任务”或“刚开完会，脑子有点乱”。',
      '写完就发送，不需要等到“足够完整”。',
    ],
    success: '成功标志：你已经能在时间线上看到自己的第一条记录。',
  },
  {
    step: '02',
    title: '再试一次语音输入',
    lead: '当你不想打字时，语音输入是把念头留住的最快方法。',
    actions: [
      '点击麦克风按钮开始录音，再点一次停止。',
      '等识别完成后，检查文字是否进入输入框。',
      '如果内容没问题，就直接发送，让它也进入事件日志。',
    ],
    success: '成功标志：你已经完成一次“想到就记下”的闭环，而不是等有空再补。',
  },
  {
    step: '03',
    title: '开始一个时间块',
    lead: 'ExoMind 不只帮你记住发生了什么，还帮你看清时间到底花在了哪里。',
    actions: [
      '在时间块名称输入框里填一个你接下来要专注的标题。',
      '开始后先去做事，结束时补一句身心反馈，例如“推进顺利，但中途分心两次”。',
      '不用追求完美统计，先让系统开始积累属于你的节奏数据。',
    ],
    success: '成功标志：你已经留下第一段可回看的专注记录，而不是只得到一个结束后就消失的计时器。',
  },
] as const;

const taskRoutes = [
  {
    title: '想快速留住一个念头',
    body: '直接写进事件输入框。不要先判断它是不是任务、是不是日记、是不是值得保存。先留下来，再回头整理。',
  },
  {
    title: '想在不打断动作的情况下记录',
    body: '优先用语音输入。ExoMind 最适合接住那些如果不当场记下，十分钟后就会消失的想法。',
  },
  {
    title: '想看清今天的时间到底去哪了',
    body: '用时间块开始一段工作，在结束时补一句反馈。你会比单纯打卡更快看到自己的工作节奏。',
  },
  {
    title: '想把另一台设备接进来',
    body: '走“网络 -> 设备 -> 设备配对”的主路径，先配对，再验证互通。普通使用场景下不要一开始就手填 host:port。',
  },
] as const;

const faqs = [
  {
    question: '没有网的时候还能用吗？',
    answer:
      '这份手册默认按普通用户主路径来写：记录、回看、本地数据都应该优先按本地优先理解。需要联网的通常是语音识别、某些在线能力或跨设备连接。如果你只是想先把事情记下来，不需要等所有网络条件都完美再开始。',
  },
  {
    question: '看不到待配对设备怎么办？',
    answer:
      '先检查两台设备是否在同一个局域网，然后确认都进入“网络 -> 设备”，并且当前运行是 running、节点可达性是“局域网”。如果这些都对，再尝试关闭并重新打开设备配对，或在设备页点击重试。',
  },
  {
    question: 'PIN 输入成功，但还是没有“已验证互通”怎么办？',
    answer:
      '这通常说明配对动作已经通过，但链路验证还没完成。先点击一次“测试互联”，等几秒看状态是否恢复；如果仍失败，再检查两端是否都在线，以及是否还在同一局域网。',
  },
  {
    question: '麦克风权限被拒绝怎么办？',
    answer:
      '先去系统或浏览器权限里把麦克风打开，再回到页面刷新重试。桌面 Chrome 可以从地址栏左侧的锁图标进入权限设置；Android 则优先检查系统里的 Chrome 权限。先把权限打通，再判断是不是识别服务问题。',
  },
  {
    question: '什么时候才需要“高级 / 兼容模式”？',
    answer:
      '当你明确知道自己要连接外部 RT、手工填写 host:port，或者正在做兼容旧链路与开发调试时，才需要进入高级 / 兼容模式。普通用户的推荐主路径始终是“发现 -> 配对 -> 验证”，不要在第一天就把自己带进进阶配置。',
  },
] as const;
---

<BaseLayout
  title="用户手册"
  description="第一次使用 ExoMind 时，从这里完成 3 分钟上手、关键使用路径和常见问题排查。"
>
  <section class="relative overflow-hidden pt-32 pb-20">
    <div class="section-container relative z-10">
      <div class="mx-auto max-w-4xl text-center">
        <p class="text-xs font-semibold uppercase tracking-[0.28em] text-brand/80">
          User Manual / 普通使用者手册
        </p>
        <h1 class="heading-display mt-5 text-4xl leading-tight text-stone-900 sm:text-5xl lg:text-6xl dark:text-stone-50">
          第一次打开 ExoMind，
          <br class="hidden sm:block" />
          先从这里开始
        </h1>
        <p class="mx-auto mt-6 max-w-3xl text-lg leading-relaxed text-stone-500 sm:text-xl">
          一天结束时，你可能很累，却说不清自己到底做了什么。
          这页手册先不讲宏大概念，只帮你完成三件事：留下第一条记录、知道下一步怎么用、卡住时知道去哪里排查。
        </p>
        <div class="mt-8 inline-flex rounded-full border border-brand/20 bg-brand/5 px-5 py-2 text-sm text-brand dark:border-brand/30 dark:bg-brand/10">
          当前这版先覆盖记录、语音输入、时间块、设备配对与基础排障
        </div>
        <div class="mt-10 flex flex-col items-center justify-center gap-4 sm:flex-row">
          <a href="#quick-start" class="btn-primary px-8 py-3.5 text-base">
            先看 3 分钟上手
          </a>
          <a href="#faq" class="btn-secondary px-8 py-3.5 text-base">
            遇到问题先看这里
          </a>
        </div>
      </div>
    </div>
    <div class="absolute inset-0 -z-10">
      <div class="absolute left-1/2 top-0 h-[560px] w-[560px] -translate-x-1/2 -translate-y-1/2 rounded-full bg-brand/10 blur-3xl"></div>
    </div>
  </section>

  <section id="overview" class="pb-20">
    <div class="section-container">
      <div class="mx-auto max-w-3xl text-center">
        <h2 class="heading-display text-3xl text-stone-900 sm:text-4xl dark:text-stone-50">
          这一页的阅读顺序
        </h2>
        <p class="mt-4 text-base leading-relaxed text-stone-500">
          ExoMind 的用户手册不会一上来把你丢进术语里，而是先让你开始使用，再告诉你为什么这样设计。
          你可以先完成前两块，后面的入口会在后续版本继续补齐。
        </p>
      </div>

      <div class="mx-auto mt-12 grid max-w-6xl gap-6 md:grid-cols-2 xl:grid-cols-5">
        {handbookSections.map((section) => (
          <a
            href={section.href}
            class:list={[
              'rounded-3xl border p-6 transition-all duration-300',
              section.available
                ? 'border-brand/20 bg-white shadow-sm hover:-translate-y-1 hover:border-brand/40 dark:border-brand/30 dark:bg-stone-900'
                : 'border-stone-200 bg-stone-50/80 dark:border-stone-800 dark:bg-stone-900/60',
            ]}
          >
            <div class="flex items-center justify-between gap-4">
              <h3 class="text-lg font-semibold text-stone-900 dark:text-stone-50">{section.title}</h3>
              <span
                class:list={[
                  'rounded-full px-3 py-1 text-xs font-medium',
                  section.available
                    ? 'bg-brand/10 text-brand'
                    : 'bg-stone-200 text-stone-600 dark:bg-stone-800 dark:text-stone-400',
                ]}
              >
                {section.status}
              </span>
            </div>
            <p class="mt-4 text-sm leading-relaxed text-stone-500 dark:text-stone-400">
              {section.summary}
            </p>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section id="quick-start" class="py-20 bg-stone-100/60 dark:bg-stone-900/50">
    <div class="section-container">
      <div class="mx-auto max-w-3xl">
        <div class="text-center">
          <p class="text-xs font-semibold uppercase tracking-[0.24em] text-brand/80">
            3 Minutes / 3 分钟上手
          </p>
          <h2 class="heading-display mt-4 text-3xl text-stone-900 sm:text-4xl dark:text-stone-50">
            先让 ExoMind 留下第一批真实痕迹
          </h2>
          <p class="mt-4 text-base leading-relaxed text-stone-500">
            不要一开始就追求完整系统。第一天只要完成下面三步，你就已经不再从空白开始了。
          </p>
        </div>

        <div class="mt-12 space-y-6">
          {quickStartSteps.map((item) => (
            <article class="rounded-[28px] border border-stone-200 bg-white p-8 shadow-sm dark:border-stone-800 dark:bg-stone-900">
              <div class="flex flex-col gap-4 sm:flex-row sm:items-start">
                <div class="shrink-0">
                  <div class="flex h-14 w-14 items-center justify-center rounded-2xl bg-brand text-lg font-semibold text-white">
                    {item.step}
                  </div>
                </div>
                <div class="flex-1">
                  <h3 class="text-2xl font-semibold text-stone-900 dark:text-stone-50">{item.title}</h3>
                  <p class="mt-3 text-base leading-relaxed text-stone-600 dark:text-stone-300">
                    {item.lead}
                  </p>
                  <ul class="mt-5 space-y-3 text-sm leading-relaxed text-stone-500 dark:text-stone-400">
                    {item.actions.map((action) => (
                      <li class="flex gap-3">
                        <span class="mt-1.5 h-2 w-2 shrink-0 rounded-full bg-brand"></span>
                        <span>{action}</span>
                      </li>
                    ))}
                  </ul>
                  <p class="mt-5 rounded-2xl bg-brand/5 px-4 py-3 text-sm font-medium text-brand dark:bg-brand/10">
                    {item.success}
                  </p>
                </div>
              </div>
            </article>
          ))}
        </div>
      </div>
    </div>
  </section>

  <section class="py-20">
    <div class="section-container">
      <div class="mx-auto max-w-3xl text-center">
        <h2 class="heading-display text-3xl text-stone-900 sm:text-4xl dark:text-stone-50">
          第二天开始，你最常走的四条路径
        </h2>
        <p class="mt-4 text-base leading-relaxed text-stone-500">
          用户手册不应该只告诉你“这个功能存在”，而应该直接告诉你“现在遇到这个情况，该往哪里走”。
        </p>
      </div>

      <div class="mx-auto mt-12 grid max-w-5xl gap-6 md:grid-cols-2">
        {taskRoutes.map((route) => (
          <div class="rounded-3xl border border-stone-200 bg-white p-7 shadow-sm dark:border-stone-800 dark:bg-stone-900">
            <h3 class="text-xl font-semibold text-stone-900 dark:text-stone-50">{route.title}</h3>
            <p class="mt-4 text-sm leading-relaxed text-stone-500 dark:text-stone-400">{route.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section id="faq" class="py-20 bg-stone-100/60 dark:bg-stone-900/50">
    <div class="section-container">
      <div class="mx-auto max-w-3xl text-center">
        <p class="text-xs font-semibold uppercase tracking-[0.24em] text-brand/80">
          FAQ / 常见问题与排障
        </p>
        <h2 class="heading-display mt-4 text-3xl text-stone-900 sm:text-4xl dark:text-stone-50">
          先回答那些会阻止你继续用下去的问题
        </h2>
        <p class="mt-4 text-base leading-relaxed text-stone-500">
          这一组问题不是知识库索引，而是“差一点就放弃时最想确认的事”。
          如果你正在卡住，先从这里找答案，而不是先跳进高级设置。
        </p>
      </div>

      <div class="mx-auto mt-12 max-w-4xl space-y-4">
        {faqs.map((item) => (
          <details class="group rounded-3xl border border-stone-200 bg-white p-6 shadow-sm transition-colors open:border-brand/30 dark:border-stone-800 dark:bg-stone-900 dark:open:border-brand/30">
            <summary class="flex cursor-pointer list-none items-center justify-between gap-6 text-left text-lg font-semibold text-stone-900 marker:hidden dark:text-stone-50">
              <span>{item.question}</span>
              <span class="text-brand transition-transform duration-300 group-open:rotate-45">+</span>
            </summary>
            <p class="mt-4 pr-8 text-sm leading-relaxed text-stone-500 dark:text-stone-400">
              {item.answer}
            </p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <section class="py-20">
    <div class="section-container">
      <div class="mx-auto max-w-4xl rounded-[32px] border border-stone-200 bg-white p-8 shadow-sm dark:border-stone-800 dark:bg-stone-900 md:p-10">
        <div class="grid gap-8 md:grid-cols-[1.3fr_1fr] md:items-center">
          <div>
            <p class="text-xs font-semibold uppercase tracking-[0.24em] text-brand/80">
              Next / 接下来读什么
            </p>
            <h2 class="heading-display mt-4 text-3xl text-stone-900 sm:text-4xl dark:text-stone-50">
              先用起来，再继续往深处走
            </h2>
            <p class="mt-4 text-base leading-relaxed text-stone-500">
              这版用户手册先把第一次使用最容易卡住的部分补齐。
              如果你已经完成第一条记录和第一次时间块，下一步建议看下载页确认平台入口，再看更新日志了解当前版本边界。
            </p>
          </div>

          <div class="space-y-3">
            <a href={downloadPath} class="btn-primary flex w-full items-center justify-center px-6 py-3 text-base">
              去下载页确认平台入口
            </a>
            <a href={changelogPath} class="btn-secondary flex w-full items-center justify-center px-6 py-3 text-base">
              查看更新日志
            </a>
            <a href={aboutPath} class="btn-secondary flex w-full items-center justify-center px-6 py-3 text-base">
              了解 ExoMind 为什么这样设计
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
