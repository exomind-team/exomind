---
import {
  getDocsIndexPath,
  getDocsPagePath,
  getDocsSections,
  type DocSlug,
  type DocsLocale,
} from "../../lib/docs";

interface Props {
  lang: DocsLocale;
  activeSlug?: DocSlug;
  activeRoot?: boolean;
}

const { lang, activeSlug, activeRoot = false } = Astro.props;
const sections = getDocsSections(lang);
const docsIndexPath = getDocsIndexPath(lang);

const copy =
  lang === "zh"
    ? {
        eyebrow: "Documentation / 文档",
        rootTitle: "导航",
      }
    : {
        eyebrow: "Documentation",
        rootTitle: "Docs Index",
      };
---

<aside class="docs-shell-sidebar">
  <div>
    <p class="text-xs font-semibold uppercase tracking-[0.24em] text-brand/80">
      {copy.eyebrow}
    </p>
    <div class="mt-4 space-y-1.5">
      <a
        href={docsIndexPath}
        aria-current={activeRoot ? "page" : undefined}
        class:list={[
          "block rounded-xl px-3 py-2.5 text-sm transition-colors",
          activeRoot
            ? "bg-stone-900 text-white dark:bg-stone-100 dark:text-stone-900"
            : "text-stone-600 hover:bg-stone-100 hover:text-stone-900 dark:text-stone-300 dark:hover:bg-stone-800 dark:hover:text-stone-50",
        ]}
      >
        <span class="block font-medium">{copy.rootTitle}</span>
      </a>
    </div>
  </div>

  <div class="mt-8 space-y-6">
    {sections.map((section) => (
      <div>
        <p class="text-xs font-semibold uppercase tracking-[0.2em] text-stone-400 dark:text-stone-500">
          {section.title}
        </p>
        <div class="mt-3 space-y-1.5">
          {section.items.map((item) => {
            const active = item.slug === activeSlug;
            return (
              <a
                href={getDocsPagePath(lang, item.slug)}
                aria-current={active ? "page" : undefined}
                class:list={[
                  "block rounded-xl px-3 py-2.5 text-sm transition-colors",
                  active
                    ? "bg-stone-900 text-white dark:bg-stone-100 dark:text-stone-900"
                    : "text-stone-600 hover:bg-stone-100 hover:text-stone-900 dark:text-stone-300 dark:hover:bg-stone-800 dark:hover:text-stone-50",
                ]}
              >
                <span class="block font-medium">{item.title}</span>
              </a>
            );
          })}
        </div>
      </div>
    ))}
  </div>
</aside>
