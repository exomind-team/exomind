---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getLocalizedPath, useTranslations } from '../../i18n';

const t = useTranslations('en');
const downloadPath = getLocalizedPath('/download', 'en');
const featuresPath = getLocalizedPath('/features', 'en');
---

<BaseLayout title="Home">
  <!-- Hero -->
  <section class="relative overflow-hidden pt-32 pb-24">
    <div class="section-container relative z-10">
      <div class="mx-auto max-w-3xl text-center">
        <div class="mb-6 inline-flex items-center gap-2 rounded-full border border-stone-200 bg-white/80 px-4 py-1.5 text-sm text-stone-600 backdrop-blur dark:border-stone-800 dark:bg-stone-900/80 dark:text-stone-400">
          ✨ Open Source · Local First · AI Powered
        </div>
        <h1 class="heading-display text-5xl leading-tight text-stone-900 sm:text-6xl lg:text-7xl dark:text-stone-50">
          {t('hero.title')}
        </h1>
        <p class="mt-6 text-lg leading-relaxed text-stone-500 sm:text-xl">
          {t('hero.subtitle')}
        </p>
        <div class="mt-10 flex flex-col items-center justify-center gap-4 sm:flex-row">
          <a href={downloadPath} class="btn-primary px-8 py-3.5 text-base">
            {t('hero.cta.download')}
          </a>
          <a href={featuresPath} class="btn-secondary px-8 py-3.5 text-base">
            {t('hero.cta.learn')}
          </a>
        </div>
      </div>
    </div>
    <div class="absolute inset-0 -z-10">
      <div class="absolute left-1/2 top-0 h-[600px] w-[600px] -translate-x-1/2 -translate-y-1/2 rounded-full bg-brand/5 blur-3xl"></div>
    </div>
  </section>

  <!-- Features Preview -->
  <section class="bg-stone-100/50 py-24 dark:bg-stone-900/30">
    <div class="section-container">
      <div class="mx-auto max-w-2xl text-center">
        <h2 class="heading-display text-3xl text-stone-900 sm:text-4xl dark:text-stone-50">
          {t('features.title')}
        </h2>
        <p class="mt-4 text-lg text-stone-500">{t('features.subtitle')}</p>
      </div>
      <div class="mt-16 grid gap-8 sm:grid-cols-2 lg:grid-cols-3">
        <!-- Event Log -->
        <div class="card hover:-translate-y-1 transition-all duration-300">
          <div class="flex h-12 w-12 items-center justify-center rounded-xl bg-brand-50 text-brand dark:bg-brand-900/30">
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"/><path d="M22 3h-6a4 4 0 0 1-4 4v14a3 3 0 0 0 3-3h7z"/></svg>
          </div>
          <h3 class="mt-4 text-lg font-semibold text-stone-900 dark:text-stone-50">{t('features.eventlog.title')}</h3>
          <p class="mt-2 text-stone-500">{t('features.eventlog.desc')}</p>
        </div>
        <!-- Time Blocks -->
        <div class="card hover:-translate-y-1 transition-all duration-300">
          <div class="flex h-12 w-12 items-center justify-center rounded-xl bg-brand-50 text-brand dark:bg-brand-900/30">
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="10" x2="14" y1="2" y2="2"/><line x1="12" x2="15" y1="14" y2="11"/><circle cx="12" cy="14" r="8"/></svg>
          </div>
          <h3 class="mt-4 text-lg font-semibold text-stone-900 dark:text-stone-50">{t('features.timeblock.title')}</h3>
          <p class="mt-2 text-stone-500">{t('features.timeblock.desc')}</p>
        </div>
        <!-- AI Agents -->
        <div class="card hover:-translate-y-1 transition-all duration-300">
          <div class="flex h-12 w-12 items-center justify-center rounded-xl bg-brand-50 text-brand dark:bg-brand-900/30">
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 8V4H8"/><rect width="16" height="12" x="4" y="8" rx="2"/><path d="M2 14h2"/><path d="M20 14h2"/><path d="M15 13v2"/><path d="M9 13v2"/></svg>
          </div>
          <h3 class="mt-4 text-lg font-semibold text-stone-900 dark:text-stone-50">{t('features.agents.title')}</h3>
          <p class="mt-2 text-stone-500">{t('features.agents.desc')}</p>
        </div>
      </div>
      <div class="mt-12 text-center">
        <a href={featuresPath} class="inline-flex items-center gap-1 text-brand font-medium hover:text-brand-600 transition-colors">
          View all features
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
        </a>
      </div>
    </div>
  </section>

  <!-- How It Works -->
  <section class="py-24">
    <div class="section-container">
      <div class="mx-auto max-w-2xl text-center">
        <h2 class="heading-display text-3xl text-stone-900 sm:text-4xl dark:text-stone-50">
          Three Simple Steps to Growth
        </h2>
      </div>
      <div class="mt-16 grid gap-8 sm:grid-cols-3">
        <div class="relative text-center">
          <div class="mx-auto flex h-16 w-16 items-center justify-center rounded-full bg-brand text-white text-2xl font-bold">1</div>
          <h3 class="mt-6 text-xl font-semibold text-stone-900 dark:text-stone-50">Record</h3>
          <p class="mt-3 text-stone-500">Log your daily events and thoughts with the event journal</p>
        </div>
        <div class="relative text-center">
          <div class="mx-auto flex h-16 w-16 items-center justify-center rounded-full bg-brand text-white text-2xl font-bold">2</div>
          <h3 class="mt-6 text-xl font-semibold text-stone-900 dark:text-stone-50">Reflect</h3>
          <p class="mt-3 text-stone-500">AI helps you discover patterns and insights from your records</p>
        </div>
        <div class="relative text-center">
          <div class="mx-auto flex h-16 w-16 items-center justify-center rounded-full bg-brand text-white text-2xl font-bold">3</div>
          <h3 class="mt-6 text-xl font-semibold text-stone-900 dark:text-stone-50">Grow</h3>
          <p class="mt-3 text-stone-500">Make better decisions based on data-driven self-understanding</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Privacy -->
  <section class="bg-stone-100/50 py-24 dark:bg-stone-900/30">
    <div class="section-container">
      <div class="mx-auto max-w-2xl text-center">
        <h2 class="heading-display text-3xl text-stone-900 sm:text-4xl dark:text-stone-50">
          Your Data, Only Yours
        </h2>
        <p class="mt-4 text-lg text-stone-500">
          ExoMind follows a local-first architecture. All your data is stored on your device, never uploaded to the cloud.
        </p>
      </div>
      <div class="mt-12 grid gap-6 sm:grid-cols-3">
        <div class="rounded-2xl border border-stone-200 bg-white p-6 text-center dark:border-stone-800 dark:bg-stone-900">
          <div class="text-3xl font-bold text-brand">100%</div>
          <div class="mt-2 text-stone-500">Local Storage</div>
        </div>
        <div class="rounded-2xl border border-stone-200 bg-white p-6 text-center dark:border-stone-800 dark:bg-stone-900">
          <div class="text-3xl font-bold text-brand">Zero</div>
          <div class="mt-2 text-stone-500">Cloud Dependency</div>
        </div>
        <div class="rounded-2xl border border-stone-200 bg-white p-6 text-center dark:border-stone-800 dark:bg-stone-900">
          <div class="text-3xl font-bold text-brand">100%</div>
          <div class="mt-2 text-stone-500">Open Source</div>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="py-24">
    <div class="section-container">
      <div class="mx-auto max-w-2xl text-center">
        <h2 class="heading-display text-3xl text-stone-900 sm:text-4xl dark:text-stone-50">
          Ready to Take Control of Your Life?
        </h2>
        <p class="mt-4 text-lg text-stone-500">
          Free to download, runs locally, your data belongs to you.
        </p>
        <div class="mt-10 flex flex-col items-center justify-center gap-4 sm:flex-row">
          <a href={downloadPath} class="btn-primary px-8 py-3.5 text-base">
            Download Now
          </a>
          <a href="https://github.com/exomind-team/exomind" target="_blank" rel="noopener" class="btn-secondary px-8 py-3.5 text-base">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="mr-2"><path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4"/><path d="M9 18c-4.51 2-5-2-7-2"/></svg>
            View on GitHub
          </a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
