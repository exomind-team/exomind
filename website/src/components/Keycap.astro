---
interface Props {
  ariaLabel?: string;
  class?: string;
  tone?: "default" | "inverse";
  value: string;
}

const { ariaLabel, class: className, tone = "default", value } = Astro.props;
---

<kbd
  aria-label={ariaLabel ?? `按键 ${value}`}
  class:list={[
    "inline-flex min-w-[1.75rem] whitespace-nowrap items-center justify-center rounded-lg px-2 py-1 text-xs font-semibold leading-none",
    tone === "inverse"
      ? "border border-white/15 bg-white/10 text-white shadow-none dark:border-stone-300/20 dark:bg-stone-900 dark:text-stone-100"
      : "border border-stone-200 bg-stone-50 text-stone-600 shadow-[inset_0_-1px_0_rgba(28,25,23,0.06)] dark:border-stone-700 dark:bg-stone-950 dark:text-stone-300",
    className,
  ]}
>
  {value}
</kbd>
